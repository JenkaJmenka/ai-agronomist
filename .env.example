# Database
DATABASE_URL=postgresql://user:password@hostname:5432/database_name
POSTGRES_DB=greenhouse_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@localhost:5432/greenhouse_monitoring  # incident memory uses pgvector when on Postgres
# Application
DEBUG=False
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# Paths
CHECKPOINT_DIR=/app/models/checkpoints
DATA_DIR=/app/data/synthetic
LOG_DIR=/app/logs/tensorboard

# Authentication (Phase D — BUG-007)
AUTH_ENABLED=false
# TENANT_API_KEYS=tenant_a:secret_key_a,tenant_b:secret_key_b
ENVIRONMENT=development
