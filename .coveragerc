[run]
concurrency = thread, greenlet
source = src
branch = True
omit =
    src/dashboard/*
    src/db/seeds.py

[report]
precision = 2
show_missing = True
skip_covered = False

exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
