INE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Override get_db dependency","action":"LINE_ACTION_INSERT"},{"text":"    app.dependency_overrides[get_db] = lambda: mock_db","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    try:","action":"LINE_ACTION_INSERT"},{"text":"        response = client.get(\"/health/db\")","action":"LINE_ACTION_INSERT"},{"text":"        assert response.status_code == status.HTTP_200_OK","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        data = response.json()","action":"LINE_ACTION_INSERT"},{"text":"        assert data == {\"status\": \"ok\", \"database\": \"connected\"}","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        # Ensure query SELECT 1 was triggered","action":"LINE_ACTION_INSERT"},{"text":"        mock_db.execute.assert_called_once()","action":"LINE_ACTION_INSERT"},{"text":"    finally:","action":"LINE_ACTION_INSERT"},{"text":"        app.dependency_overrides.clear()","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_db_health_endpoint_sqlalchemy_exception(client: TestClient) -> None:","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    GIVEN a database connectivity problem or a locked table sequence (SQLAlchemyError)","action":"LINE_ACTION_INSERT"},{"text":"    WHEN a GET request is made to '/health/db'","action":"LINE_ACTION_INSERT"},{"text":"    THEN the response status should be 503 SERVICE UNAVAILABLE and contain \"database: disconnected\".","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    mock_db = AsyncMock()","action":"LINE_ACTION_INSERT"},{"text":"    mock_db.execute.side_effect = SQLAlchemyError(\"SQLITE_BUSY: Database file is locked.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Override get_db dependency","action":"LINE_ACTION_INSERT"},{"text":"    app.dependency_overrides[get_db] = lambda: mock_db","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    try:","action":"LINE_ACTION_INSERT"},{"text":"        response = client.get(\"/health/db\")","action":"LINE_ACTION_INSERT"},{"text":"        assert response.status_code == status.HTTP_503_SERVICE_UNAVAILABLE","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        data = response.json()","action":"LINE_ACTION_INSERT"},{"text":"        assert data == {\"status\": \"error\", \"database\": \"disconnected\"}","action":"LINE_ACTION_INSERT"},{"text":"    finally:","action":"LINE_ACTION_INSERT"},{"text":"        app.dependency_overrides.clear()","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_db_health_endpoint_generic_exception(client: TestClient) -> None:","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    GIVEN a severe system error or unresolved database session query failure (Exception)","action":"LINE_ACTION_INSERT"},{"text":"    WHEN a GET request is made to '/health/db'","action":"LINE_ACTION_INSERT"},{"text":"    THEN the response status should be 503 SERVICE UNAVAILABLE and return the expected payload.","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    mock_db = AsyncMock()","action":"LINE_ACTION_INSERT"},{"text":"    mock_db.execute.side_effect = Exception(\"Unknown severe database/networking connection timeout error.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Override get_db dependency","action":"LINE_ACTION_INSERT"},{"text":"    app.dependency_overrides[get_db] = lambda: mock_db","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"  