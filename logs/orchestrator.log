ion configurations are missing","action":"LINE_ACTION_INSERT"},{"text":"                                       or if the simulated endpoint is unreachable.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        if not self.api_key:","action":"LINE_ACTION_INSERT"},{"text":"            raise DataSourceConnectionError(\"Cannot connect to Priva: api_key / credential_token is empty.\")","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        # Simulate connection establishment","action":"LINE_ACTION_INSERT"},{"text":"        self.connected = True","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def disconnect(self) -> None:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Gracefully terminates the connection instance and deallocates resources.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        self.connected = False","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def read(self) -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Reads raw sensor data directly from the vendor's source channel.","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            A pandas DataFrame representing raw sensor telemetry using Priva's proprietary format.","action":"LINE_ACTION_INSERT"},{"text":"            ","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            DataSourceConnectionError: If called before establishing connection.","action":"LINE_ACTION_INSERT"},{"text":"            DataReadError: If fetching the telemetry stream fails.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        if not self.connected:","action":"LINE_ACTION_INSERT"},{"text":"            raise DataSourceConnectionError(\"API client is not connected. Call connect() first.\")","action":"LINE_ACTION_INSERT"},{"text":"            ","action":"LINE_ACTION_INSERT"},{"text":"        try:","action":"LINE_ACTION_INSERT"},{"text":"            start_dt = self.config.get(\"start_time\")","action":"LINE_ACTION_INSERT"},{"text":"            end_dt = self.config.get(\"end_time\")","action":"LINE_ACTION_INSERT"},{"text":"            ","action":"LINE_ACTION_INSERT"},{"text":"            # Default to the last 24 hours if timestamps are not provided","action":"LINE_ACTION_INSERT"},{"text":"            if not end_dt:","action":"LINE_ACTION_INSERT"},{"text":"                end_dt = datetime.now(timezone.utc)","action":"LINE_ACTION_INSERT"},{"text":"            if not start_dt:","action":"LINE_ACTION_INSERT"},{"text":"                start_dt = end_dt - pd.Timedelta(hours=24)","action":"LINE_ACTION_INSERT"},{"text":"                ","action":"LINE_ACTION_INSERT"},{"text":"            # Convert string representations to Timestamp objects","action":"LINE_ACTION_INSERT"},{"text":"            if isinstance(start_dt, str):","action":"LINE_ACTION_INSERT"},{"text":"                start_dt = pd.to_datetime(start_dt)","action":"LINE_ACTION_INSERT"},{"text":"            if isinstance(end_dt, str):","action":"LINE_ACTION_INSERT"},{"text":"                end_dt = pd.to_datetime(end_dt)","action":"LINE_ACTION_INSERT"},{"text":"                ","action":"LINE_ACTION_INSERT"},{"text":"            # Ensure timezone awareness for dates generated","action":"LINE_ACTION_INSERT"},{"text":"            if start_dt.tzinfo is None:","action":"LINE_ACTION_INSERT"},{"text":"                start_dt = start_dt.replace(tzinfo=timezone.utc)","action":"LINE_ACTION_INSERT"},{"text":"            if end_dt.tzinfo is None:","action":"LINE_ACTION_INSERT"},{"text":"                e