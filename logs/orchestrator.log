l.path} | \"","action":"LINE_ACTION_NONE"},{"text":"        f\"Status: {response.status_code} | Duration: {duration_ms:.2f}ms | RequestID: {request_id}\"","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    return response","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Global Exception Handlers","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@app.exception_handler(RequestValidationError)","action":"LINE_ACTION_NONE"},{"text":"async def validation_exception_handler(request: Request, exc: RequestValidationError) -> JSONResponse:","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    Catches 422 Unprocessable Entity validation errors (such as Pydantic structural errors).","action":"LINE_ACTION_NONE"},{"text":"    Restructures the output with clear validation feedback and correlates with Request ID.","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    request_id = getattr(request.state, \"request_id\", \"unknown\")","action":"LINE_ACTION_NONE"},{"text":"    errors = exc.errors()","action":"LINE_ACTION_NONE"},{"text":"    logger.warning(","action":"LINE_ACTION_NONE"},{"text":"        f\"Validation failure: {request.method} {request.url.path} | \"","action":"LINE_ACTION_NONE"},{"text":"        f\"RequestID: {request_id} | Validation errors: {errors}\"","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    return JSONResponse(","action":"LINE_ACTION_NONE"},{"text":"        status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,","action":"LINE_ACTION_NONE"},{"