2026-06-09 11:03:09,242 - root - INFO - RAW WS MSG: {"seqNum":"214","timestampMicros":"1780999389242396","stepUpdate":{"cascadeId":"e64a7f8e0e97b27a7aa0744ee2b8c15e","trajectoryId":"e64a7f8e0e97b27a7aa0744ee2b8c15e","stepIndex":68,"state":"STATE_DONE","source":"SOURCE_MODEL","target":"TARGET_ENVIRONMENT","thinking":"","textDelta":"","thinkingDelta":"","text":"routes/inference.py DB saving update","editFile":{"filePath":"file:///Users/eugenesidorov/Projects/ai-agronomist/src/api/routes/inference.py","diffBlock":[{"startLine":0,"endLine":62,"lines":[{"text":"from fastapi import APIRouter, HTTPException, Depends","action":"LINE_ACTION_NONE"},{"text":"from src.api.schemas.sensor_data import InferenceRequest, InferenceResponse","action":"LINE_ACTION_NONE"},{"text":"from src.db.session import get_db","action":"LINE_ACTION_NONE"},{"text":"from sqlalchemy.ext.asyncio import AsyncSession","action":"LINE_ACTION_NONE"},{"text":"from src.db.models import SensorReading","action":"LINE_ACTION_NONE"},{"text":"from src.models.inference import AnomalyDetector","action":"LINE_ACTION_NONE"},{"text":"from typing import List, Dict, Any","action":"LINE_ACTION_NONE"},{"text":"from datetime import datetime, timezone","action":"LINE_ACTION_NONE"},{"text":"import torch","action":"LINE_ACTION_NONE"},{"text":"import numpy as np","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"router = APIRouter()","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Global model instance","action":"LINE_ACTION_NONE"},{"text":"try:","action":"LINE_ACTION_NONE"},{"text":"    # This will load model if weights exist, otherwise None","action":"LINE_ACTION_NONE"},{"text":"    detector = AnomalyDetector(checkpoint_path=\"models/lstm_vae_v1.pt\")","action":"LINE_ACTION_NONE"},{"text":"except Exception:","action":"LINE_ACTION_NONE"},{"text":"    detector = None","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@router.post(\"/inference\", response_model=InferenceResponse)","action":"LINE_ACTION_NONE"},{"text":"async def run_inference(","action":"LINE_ACTION_NONE"},{"text":"    request: InferenceRequest,","action":"LINE_ACTION_NONE"},{"text":"    db: AsyncSession = Depends(get_db)","action":"LINE_ACTION_NONE"},{"text":"):","action":"LINE_ACTION_NONE"},{"text":"    if detector is None:","action":"LINE_ACTION_NONE"},{"text":"        raise HTTPException(status_code=503, detail=\"Model not loaded or unavailable\")","action":"LINE_ACTION_NONE"},{"text":"        ","action":"LINE_ACTION_NONE"},{"text":"    seqs = request.sequences","action":"LINE_ACTION_NONE"},{"text":"    if not seqs:","action":"LINE_ACTION_NONE"},{"text":"        raise HTTPException(status_code=400, detail=\"Empty sequences\")","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    try:","action":"LINE_ACTION_NONE"},{"text":"        # Expected shape (batch, seq_len, input_dim) -> (batch, 20, 4)","action":"LINE_ACTION_NONE"},{"text":"        np_seqs = [np.array(seq, dtype=np.float32) for seq in seqs]","action":"LINE_ACTION_NONE"},{"text":"        batch_scores = detector.predict_batch(np_seqs)","action":"LINE_ACTION_NONE"},{"text":"    except Exception as e:","action":"LINE_ACTION_NONE"},{"text":"        raise HTTPException(status_code=400, detail=f\"Inference failed: {str(e)}\")","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    anomalies_detected = int((batch_scores > 0.8).sum())","action":"LINE_ACTION_NONE"},{"text":"    high_anomalies = []","action":"LINE_ACTION_NONE"},{"text":"    ","action":"LINE_ACTION_NONE"},{"text":"    # Normally we would save to DB here, but since the sequences might not","action":"LINE_ACTION_DELETE"},{"text":"    # map 1:1 to an existing DB record immediately (unless they are matched by timestamp),","action":"LINE_ACTION_DELETE"},{"text":"    # we just generate the response.","action":"LINE_ACTION_DELETE"},{"text":"    ","action":"LINE_ACTION_DELETE"},{"text":"    # Persist scores to the matching database records for this tenant/greenhouse","action":"LINE_ACTION_INSERT"},{"text":"    from sqlalchemy import select","action":"LINE_ACTION_INSERT"},{"text":"    stmt = (","action":"LINE_ACTION_INSERT"},{"text":"        select(SensorReading)","action":"LINE_ACTION_INSERT"},{"text":"        .where(","action":"LINE_ACTION_INSERT"},{"text":"            SensorReading.tenant_id == request.tenant_id,","action":"LINE_ACTION_INSERT"},{"text":"            SensorReading.greenhouse_id == request.greenhouse_id,","action":"LINE_ACTION_INSERT"},{"text":"        )","action":"LINE_ACTION_INSERT"},{"text":"        .order_by(SensorReading.timestamp.desc())","action":"LINE_ACTION_INSERT"},{"text":"        .limit(len(batch_scores))","action":"LINE_ACTION_INSERT"},{"text":"    )","action":"LINE_ACTION_INSERT"},{"text":"    db_result = await db.execute(stmt)","action":"LINE_ACTION_INSERT"},{"text":"    records = db_result.scalars().all()","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    # We update records with anomaly scores starting from the matching indices","action":"LINE_ACTION_INSERT"},{"text":"    for idx, record in enumerate(reversed(records)):","action":"LINE_ACTION_INSERT"},{"text":"        if idx < len(batch_scores):","action":"LINE_ACTION_INSERT"},{"text":"            record.anomaly_score = float(batch_scores[idx])","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    try:","action":"LINE_ACTION_INSERT"},{"text":"        await db.commit()","action":"LINE_ACTION_INSERT"},{"text":"    except Exception as e:","action":"LINE_ACTION_INSERT"},{"text":"        await db.rollback()","action":"LINE_ACTION_INSERT"},{"text":"        raise HTTPException(status_code=500, detail=f\"Failed to persist anomaly scores: {str(e)}\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    for idx, score in enumerate(batch_scores):","action":"LINE_ACTION_NONE"},{"text":"        if score > 0.8:","action":"LINE_ACTION_NONE"},{"text":"            high_anomalies.append({","action":"LINE_ACTION_NONE"},{"text":"                \"sequence_index\": idx,","action":"LINE_ACTION_NONE"},{"text":"                \"score\": float(score),","action":"LINE_ACTION_NONE"},{"text":"                \"timestamp\": datetime.now(timezone.utc).isoformat()","action":"LINE_ACTION_NONE"},{"text":"            })","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    return InferenceResponse(","action":"LINE_ACTION_NONE"},{"text":"        tenant_id=request.tenant_id,","action":"LINE_ACTION_NONE"},{"text":"        greenhouse_id=request.greenhouse_id,","action":"LINE_ACTION_NONE"},{"text":"        sequences_processed=len(seqs),","action":"LINE_ACTION_NONE"},{"text":"        anomalies_detected=anomalies_detected,","action":"LINE_ACTION_NONE"},{"text":"        anomaly_scores=batch_scores.tolist(),","action":"LINE_ACTION_NONE"},{"text":"        high_anomalies=high_anomalies","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"}]}]}}}
