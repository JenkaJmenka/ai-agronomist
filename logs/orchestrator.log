:"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    # Benchmarking request start","action":"LINE_ACTION_NONE"},{"text":"    start_time = time.time()","action":"LINE_ACTION_NONE"},{"text":"    logger.info(","action":"LINE_ACTION_NONE"},{"text":"        f\"Request started: {request.method} {request.url.path} | RequestID: {request_id}\"","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    try:","action":"LINE_ACTION_NONE"},{"text":"        response = await call_next(request)","action":"LINE_ACTION_NONE"},{"text":"    except Exception as e:","action":"LINE_ACTION_NONE"},{"text":"        # Just in case an unhandled exception manages to escape call_next","action":"LINE_ACTION_NONE"},{"text":"        process_time_ms = (time.time() - start_time) * 1000.0","action":"LINE_ACTION_NONE"},{"text":"        logger.error(","action":"LINE_ACTION_NONE"},{"text":"            f\"Exception escaped middleware: {request.method} {request.url.path} | \"","action":"LINE_ACTION_NONE"},{"text":"            f\"Duration: {process_time_ms:.2f}ms | RequestID: {request_id} | Error: {e}\",","action":"LINE_ACTION_NONE"},{"text":"            exc_info=True","action":"LINE_ACTION_NONE"},{"text":"        )","action":"LINE_ACTION_NONE"},{"text":"        raise e","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    # Benchmarking request completion","action":"LINE_ACTION_NONE"},{"text":"    duration_ms = (time.time() - start_time) * 1000.0","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    # Inject tracking ID and diagnostic header into client response","action":"LINE_ACTION_NONE"},{"text":"    response.headers[\"X-Request-ID\"] = request_id","action":"LINE_ACTION_NONE"},{"text":"    response.headers[\"X-Process-Time-Ms\"] = f\"{duration_ms:.2f}\"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    logger.info(","action":"LINE_ACTION_NONE"},{"text":"        f\"Request completed: {request.method} {request.url.path} | \"","action":"LINE_ACTION_NONE"},{"text":"        f\"Status: {response.status_code} | Duration: {duration_ms:.2f}ms | RequestID: {request_id}\"","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    return response","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Global Exception Handlers","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@app.exception_handler(RequestValidationError)","action":"LINE_ACTION_NONE"},{"text":"async def validation_exception_handler(request: Request, exc: RequestValidationError) -> JSONResponse:","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    Catches 422 Unprocessable Entity validation errors (such as Pydantic structural errors).","action":"LINE_ACTION_NONE"},{"text":"    Restructures the output with clear validation feedback and correlates with Request ID.","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    request_id = getattr(request.state, \"request_id\", \"unknown\")","action":"LINE_ACTION_NONE"},{"text":"    errors = exc.errors()","action":"LINE_ACTION_NONE"},{"text":"    logger.warning(","action":"LINE_ACTION_NONE"},{"text":"        f\"Validation failure: {request.method} {request.url.path} | \"","action":"LINE_ACTION_NONE"},{"text":"        f\"RequestID: {request_id} | Validation errors: {errors}\"","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    return JSONResponse(","action":"LINE_ACTION_NONE"},{"text":"        status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,","action":"LINE_ACTION_NONE"},{"text":"        content={","action":"LINE_ACTION_NONE"},{"text":"            \"detail\": errors,","action":"LINE_ACTION_NONE"},{"text":"            \"message\": \"The incoming payload validation failed. Please check the structure of your fields.\",","action":"LINE_ACTION_NONE"},{"text":"            \"request_id\": request_id,","action":"LINE_ACTION_NONE"},{"text":"        },","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@app.exception_handler(StarletteHTTPException)","action":"LINE_ACTION_NONE"},{"text":"async def http_exception_handler(request: Request, exc: StarletteHTTPException) -> JSONResponse:","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    Catches standard Starlette / FastAPI HTTPException.","action":"LINE_ACTION_NONE"},{"text":"    Simplifies the error structure and stamps details with Request ID.","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    request_id = getattr(request.state, \"request_id\", \"unknown\")","action":"LINE_ACTION_NONE"},{"text":"    logger.warning(","action":"LINE_ACTION_NONE"},{"text":"        f\"HTTP operational error: {request.method} {request.url.path} | \"","action":"LINE_ACTION_NONE"},{"text":"        f\"Status: {exc.status_code} | Reason: {exc.detail} | RequestID: {request_id}\"","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    return JSONResponse(","action":"LINE_ACTION_NONE"},{"text":"        status_code=exc.status_code,","action":"LINE_ACTION_NONE"},{"text":"        content={","action":"LINE_ACTION_NONE"},{"text":"            \"message\": exc.detail,","action":"LINE_ACTION_NONE"},{"text":"            \"request_id\": request_id,","action":"LINE_ACTION_NONE"},{"text":"        },","action":"LINE_ACTION_NONE