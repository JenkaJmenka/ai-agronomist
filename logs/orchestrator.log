,"action":"LINE_ACTION_INSERT"},{"text":"    adapter = CSVAdapter({\"file_path\": \"fake_path.csv\"})","action":"LINE_ACTION_INSERT"},{"text":"    assert adapter.connected is False","action":"LINE_ACTION_INSERT"},{"text":"    adapter.connect()","action":"LINE_ACTION_INSERT"},{"text":"    assert adapter.connected is True","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_disconnect():","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Tests that disconnect() resets target connection status successfully.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    adapter = CSVAdapter({\"file_path\": \"fake_path.csv\"})","action":"LINE_ACTION_INSERT"},{"text":"    adapter.connect()","action":"LINE_ACTION_INSERT"},{"text":"    assert adapter.connected is True","action":"LINE_ACTION_INSERT"},{"text":"    adapter.disconnect()","action":"LINE_ACTION_INSERT"},{"text":"    assert adapter.connected is False","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_read_disconnected_raises_error():","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Tests that read() raises DataSourceConnectionError if connect() was not called first.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    adapter = CSVAdapter({\"file_path\": \"some_file.csv\"})","action":"LINE_ACTION_INSERT"},{"text":"    with pytest.raises(DataSourceConnectionError) as exc_info:","action":"LINE_ACTION_INSERT"},{"text":"        adapter.read()","action":"LINE_ACTION_INSERT"},{"text":"    assert \"Adapter is disconnected. Call connect() first.\" in str(exc_info.value)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_read_without_file_path_generates_mock_data():","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Tests fallback mock telemetry generation when no file_path is specified in co