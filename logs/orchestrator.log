"LINE_ACTION_NONE"},{"text":"from unittest.mock import patch, MagicMock","action":"LINE_ACTION_NONE"},{"text":"from fastapi.testclient import TestClient","action":"LINE_ACTION_NONE"},{"text":"from fastapi import status","action":"LINE_ACTION_NONE"},{"text":"from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker, AsyncSession","action":"LINE_ACTION_NONE"},{"text":"from sqlalchemy import select","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"from src.api.main import app","action":"LINE_ACTION_NONE"},{"text":"from src.db.session import get_db","action":"LINE_ACTION_NONE"},{"text":"from src.db.models import Base, SensorReading","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@pytest.fixture","action":"LINE_ACTION_NONE"},{"text":"async def test_sequences():","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"Generates a batch of 150 valid sequences with size (seq_len=20, input_dim=4).\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    return np.random.rand(150, 20, 4).tolist()","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@pytest_asyncio.fixture","action":"LINE_ACTION_NONE"},{"text":"async def test_database():","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"Provides an isolated async SQLite in-memory database seeded with tenant records.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    engine = create_async_engine(\"sqlite+aiosqlite:///:memory:\", echo=False)","action":"LINE_ACTION_NONE"},{"text":"    async with engine.begin() as conn:","action":"LINE_ACTION_NONE"},{"text":"        await conn.run_sync(Base.metadata.create_all)","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    TestingSessionLocal = async_sessionmaker(","action":"LINE_ACTION_NONE"},{"text":"        bind=engine,","action":"LINE_ACTION_NONE"},{"text":"        class_=AsyncSession,","action":"LINE_ACTION_NONE"},{"text":"        expire_on_commit=False,","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    # Seed 150 database records for tenant_1 to allow updates in tests","action":"LINE_ACTION_NONE"},{"text":"    async with TestingSessionLocal() as session:","action":"LINE_ACTION_NONE"},{"text":"        base_time = datetime.datetime.now(datetime.timezone.utc)","action":"LINE_ACTION_NONE"},{"text":"        for i in range(150):","action":"LINE_ACTION_NONE"},{"text":"            reading = SensorReading(","action":"LINE_ACTION_NONE"},{"text":"                tenant_id=\"tenant_1\",","action":"LINE_ACTION_NONE"},{"text":"                greenhouse_id=\"default\",","action":"LINE_ACTION_NONE"},{"text":"                timestamp=base_time - datetime.timedelta(minutes=i),","action":"LINE_ACTION_NONE"},{"text":"                temperature=24.5,","action":"LINE_ACTION_NONE"},{"text":"                humidity=50.3,","action":"LINE_ACTION_NONE"},{"text":"                co2=400.0,","action":"LINE_ACTION_NONE"},{"text":"                light=1200.0,","action":"LINE_ACTION_NONE"},{"text":"                anomaly_score=None","action":"LINE_ACTION_NONE"},{"text":"            )","action":"LINE_ACTION_NONE"},{"text":"            session.add(reading)","action":"LINE_ACTION_NONE"},{"text":"        await session.commit()","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    async with TestingSessionLocal() as session:","action":"LINE_ACTION_NONE"},{"text":"        yield session","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    await engine.dispose()","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@pytest.fixture","action":"LINE_ACTION_NONE"},{"text":"def test_client(test_database):","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"Overrides standard database dependency with test database session.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    async def override_get_db():","action":"LINE_ACTION_NONE"},{"text":"        yield test_database","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    app.dependency_overrides[get_db] = override_get_db","action":"LINE_ACTION_NONE"},{"text":"    with TestClient(app) as client:","action":"LINE_ACTION_NONE"},{"text":"        yield client","action":"LINE_ACTION_NONE"},{"text":"    app.dependency_overrides.clear()","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@pytest.fixture(autouse=True)","action":"LINE_ACTION_NONE"},{"text":"def patch_detector():","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"Autouse fixture that patches the AnomalyDetector with a predictable mock.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    with patch(\"src.api.routes.inference.AnomalyDetector.predict_batch\") as mock_predict_batch:","action":"LINE_ACTION_NONE"},{"text":"        # We return 0.3 raw score because the inference route divides by 2.0 -> final score 0.15","action":"LINE_ACTION_NONE"},{"text":"        mock_predict_batch.side_effect = lambda seqs: np.array([0.3] * len(seqs), dtype=np.float32)","action":"LINE_ACTION_NONE"},{"text":"        yield mock_predict_batch","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"def test_inference_returns_scores(test_client, test_sequences):","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"POST /api/inference with valid sequences should return 200 and anomaly scores.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    response = test_client.post(","action":"LINE_ACTION_NONE"},{"text":"        \"/api/inference\",","action":"LINE_ACTION_NONE"},{"text":"        json={\"sequences\": test_sequences, \"tenant_id\": \"tenant_1\", \"greenhouse_id\": \"default\"}","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    assert response.status_code == status.HTTP_200_OK","action":"LINE_ACTION_NONE"},{"text":"    data = response.json()","action":"LINE_ACTION_NONE"},{"text":"    assert \"anomaly_scores\" in data","action":"LINE_ACTION_NONE"},{"text":"    assert \"anomalies_detected\" in data","action":"LINE_ACTION_NONE"},{"text":"    assert \"high_anomalies\" in data","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"def test_inference_score_shape(test_client, test_sequences):","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"Verifies that processing 150 sequences generates precisely 150 continuous scores.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    response = test_client.post(","action":"LINE_ACTION_NONE"},{"text":"        \"/api/inference\",","action":"LINE_ACTION_NONE"},{"text":"        json={\"sequences\": test_sequences, \"tenant_id\": \"tenant_1\", \"greenhouse_id\": \"default\"}","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    assert response.status_code == status.HTTP_200_OK","action":"LINE_ACTION_NONE"},{"text":"    data = response.json()","action":"LINE_ACTION_NONE"},{"text":"    assert len(data[\"anomaly_scores\"]) == 150","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"def test_inference_score_range(patch_detector, test_client, test_sequences):","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"Verifies that all returned anomaly score coordinates remain well-bounded between 0 and 1.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    # Let's override the mock behavior to yield escalating boundaries from 0.0 to 2.0 (divided by 2 gives 0 to 1)","action":"LINE_ACTION_NONE"},{"text":"    patch_detector.side_effect = lambda seqs: np.linspace(0.0, 2.0, len(seqs), dtype=np.float32)","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    response = test_client.post(","action":"LINE_ACTION_NONE"},{"text":"        \"/api/inference\",","action":"LINE_ACTION_NONE"},{"text":"        json={\"sequences\": test_sequences, \"tenant_id\": \"tenant_1\", \"greenhouse_id\": \"default\"}","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    assert response.status_code == status.HTTP_200_OK","action":"LINE_ACTION_NONE"},{"text":"    scores = response.json()[\"anomaly_scores\"]","action":"LINE_ACTION_NONE"},{"text":"    assert min(scores) == pytest.approx(0.0)","action":"LINE_ACTION_NONE"},{"text":"    assert max(scores) == pytest.approx(1.0)","action":"LINE_ACTION_NONE"},{"text":"    assert all(0.0 <= s <= 1.0 for s in scores)","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"def test_inference_missing_tenant_id(test_client, test_sequences):","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"POST /api/inference with missing tenant_id parameter should trigger validation 422 block.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    response = test_client.post(","action":"LINE_ACTION_NONE"},{"text":"        \"/api/inference\",","action":"LINE_ACTION_NONE"},{"text":"        json={\"sequences\": test_sequences}  # missing tenant_id","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    assert response.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY","action":"LINE_ACTION_NONE"},{"text":"    assert \"tenant_id\" in str(response.json()).lower() or \"detail\" in response.json()","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"def test_inference_invalid_sequence_shape(test_client):","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"POST with wrong dimensions (like shape 10x5 instead of 20x4) should fail validation with 422.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    invalid_matrix = np.random.rand(10, 5).tolist() # invalid dims","action":"LINE_ACTION_NONE"},{"text":"    response = test_client.post(","action":"LINE_ACTION_NONE"},{"text":"        \"/api/inference\",","action":"LINE_ACTION_NONE"},{"text":"        json={\"sequences\": [invalid_matrix], \"tenant_id\": \"tenant_1\"}","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    assert response.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY","action":"LINE_ACTION_NONE"},{"text":"    assert \"sequence\" in str(response.json()).lower() or \"detail\" in response.json()","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"def test_inference_nan_in_input(test_client, test_sequences):","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"Inputs containing NaN or None features should return error status code 400 or 422.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    # Insert None/NaN in sequence details","action":"LINE_ACTION_NONE"},{"text":"    bad_sequences = test_sequences.copy()","action":"LINE_ACTION_NONE"},{"text":"    bad_sequences[0][0][0] = None  # invalid value","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    response = test_client.post(","action":"LINE_ACTION_NONE"},{"text":"        \"/api/inference\",","action":"LINE_ACTION_NONE"},{"text":"        json={\"sequences\": bad_sequences, \"tenant_id\": \"tenant_1\"}","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    assert response.status_code in (status.HTTP_400_BAD_REQUEST, status.HTTP_422_UNPROCESSABLE_ENTITY)","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@pytest.mark.asyncio","action":"LINE_ACTION_NONE"},{"text":"async def test_inference_saves_to_database(patch_detector, test_client, test_database, test_sequences):","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"Checks that running inference successfully writes computed anomaly scores to respective database records.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    # Predict exactly 1.44 for all items (divided by 2.0 gives 0.72)","action":"LINE_ACTION_NONE"},{"text":"    patch_detector.side_effect = lambda seqs: np.array([1.44] * len(seqs), dtype=np.float32)","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    response = test_client.post(","action":"LINE_ACTION_NONE"},{"text":"        \"/api/inference\",","action":"LINE_ACTION_NONE"},{"text":"        json={\"sequences\": test_sequences, \"tenant_id\": \"tenant_1\", \"greenhouse_id\": \"default\"}","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    assert response.status_code == status.HTTP_200_OK","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    # Query the database to retrieve rows and assert the presence of updated anomaly scores","action":"LINE_ACTION_NONE"},{"text":"    result = await test_database.execute(select(SensorReading).where(SensorReading.tenant_id == \"tenant_1\"))","action":"LINE_ACTION_NONE"},{"text":"    readings = result.scalars().all()","action":"LINE_ACTION_NONE"},{"text":"    assert len(readings) == 150","action":"LINE_ACTION_NONE"},{"text":"    assert any(r.anomaly_score == pytest.approx(0.72) for r in readings)","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"def test_inference_model_not_found(test_client, test_sequences):","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"If AnomalyDetector throws Exception on init, endpoint will return 503 model not loaded error.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    with patch(\"src.api.routes.inference.AnomalyDetector\") as mock_class:","action":"LINE_ACTION_NONE"},{"text":"        mock_class.side_effect = Exception(\"Model weights not found\")","action":"LINE_ACTION_NONE"},{"text":"        response = test_client.post(","action":"LINE_ACTION_NONE"},{"text":"            \"/api/inference\",","action":"LINE_ACTION_NONE"},{"text":"            json={\"sequences\": test_sequences, \"tenant_id\": \"tenant_1\"}","action":"LINE_ACTION_NONE"},{"text":"        )","action":"LINE_ACTION_NONE"},{"text":"        assert response.status_code == status.HTTP_503_SERVICE_UNAVAILABLE","action":"LINE_ACTION_NONE"},{"text":"        assert \"failed to initialize\" in str(response.json()).lower()","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"def test_inference_response_includes_high_anomalies(patch_detector, test_client, test_sequences):","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"Scores verified above threshold value of 0.8 should trigger high anomaly listings in outputs.\"\"\"","action":"LINE_ACTION_NONE"},{"text":"    # Force first sequence score at 1.9 (high anomaly, gives 0.95), rest safe at 0.24 (gives 0.12)","action":"LINE_ACTION_NONE"},{"text":"    def mock_predict(seqs):","action":"LINE_ACTION_NONE"},{"text":"        out = np.array([0.24] * len(seqs), dtype=np.float32)","action":"LINE_ACTION_NONE"},{"text":"        out[0] = 1.9","action":"LINE_ACTION_NONE"},{"text":"        return out","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    patch_detector.side_effect = mock_predict","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    response = test_client.post(","action":"LINE_ACTION_NONE"},{"text":"        \"/api/inference\",","action":"LINE_ACTION_NONE"},{"text":"        json={\"sequences\": test_sequences, \"tenant_id\": \"tenant_1\", \"greenhouse_id\": \"default\"}","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    assert response.status_code == status.HTTP_200_OK","action":"LINE_ACTION_NONE"},{"text":"    data = response.json()","action":"LINE_ACTION_NONE"},{"text":"    assert data[\"anomalies_detected\"] == 1","action":"LINE_ACTION_NONE"},{"text":"    assert len(data[\"high_anomalies\"]) == 1","action":"LINE_ACTION_NONE"},{"text":"    assert data[\"high_anomalies\"][0][\"sequence_index\"] == 0","action":"LINE_ACTION_NONE"},{"text":"    assert data[\"high_anomalies\"][0][\"score\"] == pytest.approx(0.95)","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_inference_upload_csv(test_client, patch_detector):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"POST /api/inference/upload with valid CSV should process and return anomaly details.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    csv_content = (","action":"LINE_ACTION_INSERT"},{"text":"        \"timestamp,temperature,humidity,co2,light\\n\"","action":"LINE_ACTION_INSERT"},{"text":"        + \"\\n\".join([f\"2026-06-09T11:00:{i%60:02d}Z,25.0,50.0,400.0,1200.0\" for i in range(50)])","action":"LINE_ACTION_INSERT"},{"text":"    )","action":"LINE_ACTION_INSERT"},{"text":"    import io","action":"LINE_ACTION_INSERT"},{"text":"    csv_bytes = io.BytesIO(csv_content.encode(\"utf-8\"))","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    response = test_client.post(","action":"LINE_ACTION_INSERT"},{"text":"        \"/api/inference/upload\",","action":"LINE_ACTION_INSERT"},{"text":"        files={\"file\": (\"test_inference.csv\", csv_bytes, \"text/csv\")},","action":"LINE_ACTION_INSERT"},{"text":"        data={\"tenant_id\": \"tenant_1\", \"greenhouse_id\": \"house_alpha\"}","action":"LINE_ACTION_INSERT"},{"text":"    )","action":"LINE_ACTION_INSERT"},{"text":"    assert response.status_code == status.HTTP_200_OK","action":"LINE_ACTION_INSERT"},{"text":"    data = response.json()","action":"LINE_ACTION_INSERT"},{"text":"    assert data[\"tenant_id\"] == \"tenant_1\"","action":"LINE_ACTION_INSERT"},{"text":"    assert data[\"greenhouse_id\"] == \"house_alpha\"","action":"LINE_ACTION_INSERT"},{"text":"    # 50 rows, seq_len 20 -> 50 - 20 + 1 = 31 sequences processed","actio