{"text":"","action":"LINE_ACTION_NONE"},{"text":"@app.exception_handler(Exception)","action":"LINE_ACTION_NONE"},{"text":"async def default_unhandled_exception_handler(request: Request, exc: Exception) -> JSONResponse:","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    Catch-all global exception handler returning a sanitized 500 error payload to","action":"LINE_ACTION_NONE"},{"text":"    the client while fully logging the internal traceback for backend engineering auditing.","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    request_id = getattr(request.state, \"request_id\", \"unknown\")","action":"LINE_ACTION_NONE"},{"text":"    logger.error(","action":"LINE_ACTION_NONE"},{"text":"        f\"Unhandled application exception: {request.method} {request.url.path} | \"","action":"LINE_ACTION_NONE"},{"text":"        f\"RequestID: {request_id} | Error: {str(exc)}\",","action":"LINE_ACTION_NONE"},{"text":"        exc_info=True,","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"    return JSONResponse(","action":"LINE_ACTION_NONE"},{"text":"        status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,","action":"LINE_ACTION_NONE"},{"text":"        content={","action":"LINE_ACTION_NONE"},{"text":"            \"message\": \"An internal server error occurred. Please contact system administrators.\",","action":"LINE_ACTION_NONE"},{"text":"            \"request_id\": request_id,","action":"LINE_ACTION_NONE"},{"text":"        },","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Health & Status Diagnostics Routes","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@app.get(\"/health\", tags=[\"Health Checks\"])","action":"LINE_ACTION_DELETE"},{"text":"async def get_health_status() -> dict:","action":"LINE_ACTION_DELETE"},{"text":"    \"\"\"","action":"LINE_ACTION_DELETE"},{"text":"    Verifies that the API service is currently up and responding.","action":"LINE_ACTION_DELETE"},{"text":"    \"\"\"","action":"LINE_ACTION_DELETE"},{"text":"    return {","action":"LINE_ACTION_DELETE"},{"text":"        \"status\": \"healthy\",","action":"LINE_ACTION_DELETE"},{"text":"        \"app\": \"AI Agronomist API\",","action":"LINE_ACTION_DELETE"},{"text":"        \"timestamp\": time.time(),","action":"LINE_ACTION_DELETE"},{"text":"    }","action":"LINE_ACTION_DELETE"},{"text":"","action":"LINE_ACTION_DELETE"},{"text":"","action":"LINE_ACTION_DELETE"},{"text":"@app.get(\"/health/db\", tags=[\"Health Checks\"])","action":"LINE_ACTION_DELETE"},{"text":"async def get_db_health_status(db: AsyncSession = Depends(get_db)) -> dict:","action":"LINE_ACTION_DELETE"},{"text":"    \"\"\"","action":"LINE_ACTION_DELETE"},{"text":"    Verifies the operational status of the underlying database connectivity.","action":"LINE_ACTION_DELETE"},{"text":"    \"\"\"","action":"LINE_ACTION_DELETE"},{"text":"    try:","action":"LINE_ACTION_DELETE"},{"text":"        # Perform low-overhead database operation query checking engine response","action":"LINE_ACTION_DELETE"},{"text":"        result = await db.execute(text(\"SELECT 1\"))","action":"LINE_ACTION_DELETE"},{"text":"        result.scalar()","action":"LINE_ACTION_DELETE"},{"text":"        return {","action":"LINE_ACTION_DELETE"},{"text":"            \"status\": \"healthy\",","action":"LINE_ACTION_DELETE"},{"text":"            \"database\": \"connected\",","action":"LINE_ACTION_DELETE"},{"text":"            \"timestamp\": time.time(),","action":"LINE_ACTION_DELETE"},{"text":"        }","action":"LINE_ACTION_DELETE"},{"text":"    except Excepti