:"    \"http://localhost:3000\",   # Default React developer port","action":"LINE_ACTION_NONE"},{"text":"    \"http://localhost:8501\",   # Default Streamlit dashboard port","action":"LINE_ACTION_NONE"},{"text":"    \"http://127.0.0.1\",","action":"LINE_ACTION_NONE"},{"text":"    \"http://127.0.0.1:3000\",","action":"LINE_ACTION_NONE"},{"text":"    \"http://127.0.0.1:8501\",","action":"LINE_ACTION_NONE"},{"text":"]","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"app.add_middleware(","action":"LINE_ACTION_NONE"},{"text":"    CORSMiddleware,","action":"LINE_ACTION_NONE"},{"text":"    allow_origins=origins,","action":"LINE_ACTION_NONE"},{"text":"    allow_credentials=True,","action":"LINE_ACTION_NONE"},{"text":"    allow_methods=[\"*\"],","action":"LINE_ACTION_NONE"},{"text":"    allow_headers=[\"*\"],","action":"LINE_ACTION_NONE"},{"text":")","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@app.middleware(\"http\")","action":"LINE_ACTION_NONE"},{"text":"async def add_request_id_and_log_middleware(request: Request, call_next: Callable) -> Response:","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    Middleware that generates and injects an X-Request-ID for all requests,","action":"LINE_ACTION_NONE"},{"text":"    logs incoming and outgoing paths with duration tracking, and injects","action":"LINE_ACTION_NONE"},{"text":"    request context parameters into the response headers.","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    # Extract existing Request ID from client header, or generate a fresh UUID4","action":"LINE_ACTION_NONE"},{"text":"    request_id = request.headers.get(\"X-Request-ID\") or str(uuid.uuid4())","action":"LINE_ACTION_NONE"},{"text":"    request.state.request_id = request_id","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    # Benchmarking request start","action":"LINE_ACTION_NONE"},{"text":"    start_time = time.time()","action":"LINE_ACTION_NONE"},{"text":"    logger.info(","action":"LINE_ACTION_NONE"},{"text":"        f\"Request started: {request.method} {request.url.path} | RequestID: {request_id}\"","action":"LINE_ACTION_NONE"},{"text":"    )","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    try:","action":"LINE_ACTION_NONE"},{"text":"        response = await call_next(request)","action":"LINE_ACTION_NONE"},{"text":"    except Exception as e:","action":"LINE_ACTION_NONE"},{"text":"        # Just in case an unhandled exception manages to escape call_next","action":"LINE_ACTION_NONE"},{"text":"        process_time_ms = (time.time() - start_time) * 1000.0","action":"LINE_ACTION_NONE"},{"text":"        logger.error(","action":"LINE_ACTION_NONE"},{"text":"            f\"Exception escaped middleware: {request.method} {request.url.path} | \"","action":"LINE_ACTION_NONE"},{"text":"            f\"Duration: {process_time_ms:.2f}ms | RequestID: {request_id} | Error: {e}\",","action":"LINE_ACTION_NONE"},{"text":"            exc_info=True","action":"LINE_ACTION_NONE"},{"text":"        )","action":"LINE_ACTION_NONE"},{"text":"        raise e","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    # Benchmarking request completion","action":"LINE_ACTION_NONE"},{"text":"    duration_ms = (time.time() - start_time) * 1000.0","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    # Inject tracking ID and diagnostic header into client response","action":"LINE_ACTION_NONE"},{"text":"    response.headers[\"X-Request-ID\"] = request_id","action":"LINE_ACTION_NONE"},{"text":"    response.headers[\"X-Process-Time-Ms\"] = f\"{duration_ms:.2f}\"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    logger.info(","action":"LINE_ACTION_NONE"},{"text":"        f\"Request completed: {request.method} {request.url