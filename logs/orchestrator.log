mport JSONResponse","action":"LINE_ACTION_NONE"},{"text":"from starlette.exceptions import HTTPException as StarletteHTTPException","action":"LINE_ACTION_NONE"},{"text":"from sqlalchemy.ext.asyncio import AsyncSession","action":"LINE_ACTION_NONE"},{"text":"from sqlalchemy import text","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Try to load formatted logging configurations from our devops setup","action":"LINE_ACTION_NONE"},{"text":"try:","action":"LINE_ACTION_NONE"},{"text":"    from src.logging.config import setup_logging","action":"LINE_ACTION_NONE"},{"text":"    setup_logging()","action":"LINE_ACTION_NONE"},{"text":"except ImportError:","action":"LINE_ACTION_NONE"},{"text":"    logging.basicConfig(level=logging.INFO)","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"from src.db.session import engine, get_db, init_db","action":"LINE_ACTION_NONE"},{"text":"from src.api.routes import health","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Initialize module logger","action":"LINE_ACTION_NONE"},{"text":"logger = logging.getLogger(\"api.main\")","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@asynccontextmanager","action":"LINE_ACTION_NONE"},{"text":"async def lifespan(app: FastAPI) -> AsyncGenerator[None, None]:","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    Asynchronous lifespan manager handling startup database initialization","action":"LINE_ACTION_NONE"},{"text":"    and shutdown resource cleanup.","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    logger.info(\"Starting up FastAPI application...\")","action":"LINE_ACTION_NONE"},{"text":"    try:","action":"LINE_ACTION_NONE"},{"text":"        # Initialize database tables on startup","action":"LINE_ACTION_NONE"},{"text":"        await init_db()","action":"LINE_ACTION_NONE"},{"text":"        logger.info(\"Database schema initialized successfully.\")","action":"LINE_ACTION_NONE"},{"text":"    except Exception as e:","action":"LINE_ACTION_NONE"},{"text":"        logger.critical(f\"Failed to initialize database: {e}\", exc_info=True)","action":"LINE_ACTION_NONE"},{"text":"        raise e","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    yield","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    logger.info(\"Shutting down FastAPI application...\")","action":"LINE_ACTION_NONE"},{"text":"    try:","action":"LINE_ACTION_NONE"},{"text":"        # Dispose of SQLAlchemy pool and close active connections","action":"LINE_ACTION_NONE"},{"text":"        await engine.dispose()","action":"LINE_ACTION_NONE"},{"text":"        logger.info(\"Database connection engine successfully disposed.\")","action":"LINE_ACTION_NONE"},{"text":"    except Exception as e:","action":"LINE_ACTION_NONE"},{"text":"        logger.error(f\"Failed to cleanly dispose of database resources: {e}\", exc_info=True)","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Instantiate the FastAPI app","action":"LINE_ACTION_NONE"},{"text":"app = FastAPI(","action":"LINE_ACTION_NONE"},{"text":"    title=\"AI Agronomist API\",","action":"LINE_ACTION_NONE"},{"text":"    description=\"REST API for multi-tenant greenhouse telemetry data ingestion, inference, and threshold management.\",","action":"LINE_ACTION_NONE"},{"text":"    version=\"1.0.0\",","action":"LINE_ACTION_NONE"},{"text":"    lifespan=lifespan,","action":"LINE_ACTION_NONE"},{"text":")","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# CORS configurations allowing Streamlit dashboard and local React/Vue dev tools","action":"LINE_ACTION_NONE"},{"text":"origins = [","action":"LINE_ACTION_NONE"},{"text":"    \"http://localhost\",","action":"LINE_ACTION_NONE"},{"text":"    \"http://localhost:3000\",   # Default React developer port","action":"LINE_ACTION_NONE"},{"text":"    \"http://localhost:8501\",   # Default Streamlit dashboard port","action":"LINE_ACTION_NONE"},{"text":"    \"http://127.0.0.1\",","action":"LINE_ACTION_NONE"},{"text":"    \"http://127.0.0.1:3000\",","action":"LINE_ACTION_NONE"},{"text":"    \"http://127.0.0.1:8501\",","action":"LINE_ACTION_NONE"},{"text":"]","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"app.add_middleware(","action":"LINE_ACTION_NONE"},{"text":"    CORSMiddleware,","action":"LINE_ACTION_NONE"},{"text":"    allow_origins=origins,","action":"LINE_ACTION_NONE"},{"text":"    allow_credentials=True,","action":"LINE_ACTION_NONE"},{"text":"    allow_methods=[\"*\"],","action":"LINE_ACTION_NONE"},{"text":"    allow_headers=[\"*\"],","action":"LINE_ACTION_NONE"},{"text":")","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"@app.middleware(\"http\")","action":"LINE_ACTION_NONE"},{"text":"async def add_request_id_and_log_middleware(request: Request, call_next: Callable) -> Response:","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    Middleware that generates and injects an X-Request-ID for all requests,","action":"LINE_ACTION_NONE"},{"text":"    logs incoming and outgoing paths with duration tracking, and injects","action":"LINE_ACTION_NONE"},{"text":"    request context parameters into the response headers.","action":"LINE_ACTION_NONE"},{"text":"    \"\"\"","action":"LINE_ACTION_NONE"},{"text":"    # Extract existing Request ID from client header, or generate a fresh UUID4","action":"LINE_ACTION_NONE"},{"text":"    request_id = request.headers.get(\"X-Request-ID\") or str(uuid.uuid4())","action":"LINE_ACTION_NONE"},{"text":"    request.state.request_id = request_id","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"    # Benchmarking