2026-06-08 18:32:20,034 - root - INFO - RAW WS MSG: {"seqNum":"13","timestampMicros":"1780939940034268","stepUpdate":{"cascadeId":"6edd1428b85bbb21473d6af2db1407d9","trajectoryId":"6edd1428b85bbb21473d6af2db1407d9","stepIndex":4,"state":"STATE_DONE","source":"SOURCE_MODEL","target":"TARGET_ENVIRONMENT","thinking":"","textDelta":"","thinkingDelta":"","text":"Create inference.py","editFile":{"filePath":"file:///Users/eugenesidorov/Projects/ai-agronomist/src/models/inference.py","diffBlock":[{"startLine":0,"endLine":0,"lines":[{"text":"","action":"LINE_ACTION_INSERT"},{"text":"import torch","action":"LINE_ACTION_INSERT"},{"text":"import numpy as np","action":"LINE_ACTION_INSERT"},{"text":"from typing import Optional, List, Dict, Any","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"from src.models.lstm_vae import LSTMVAE, LSTMVAEConfig","action":"LINE_ACTION_INSERT"},{"text":"from src.models.checkpoint_manager import CheckpointManager","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"class AnomalyDetector:","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    Anomaly detector using a trained LSTM-VAE model.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    This class provides methods for loading a trained model from a checkpoint,","action":"LINE_ACTION_INSERT"},{"text":"    predicting anomaly scores for new data, and handling various edge cases","action":"LINE_ACTION_INSERT"},{"text":"    such as variable-length input sequences and invalid input shapes.","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    _model_cache: Dict[str, LSTMVAE] = {}","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def __init__(self, model_name: str, checkpoint_dir: str = \"models/checkpoints\"):","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Initializes the AnomalyDetector.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            model_name (str): The name of the model to load.","action":"LINE_ACTION_INSERT"},{"text":"            checkpoint_dir (str): The directory where model checkpoints are stored.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        self.model_name = model_name","action":"LINE_ACTION_INSERT"},{"text":"        self.checkpoint_dir = checkpoint_dir","action":"LINE_ACTION_INSERT"},{"text":"        self.model = self._load_model()","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def _load_model(self) -> LSTMVAE:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Loads a trained LSTM-VAE model from a checkpoint.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Handles model caching to avoid reloading the model on subsequent instantiations.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            LSTMVAE: The loaded LSTM-VAE model.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            FileNotFoundError: If the model checkpoint is not found.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        if self.model_name in self._model_cache:","action":"LINE_ACTION_INSERT"},{"text":"            return self._model_cache[self.model_name]","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        checkpoint_manager = CheckpointManager(self.checkpoint_dir)","action":"LINE_ACTION_INSERT"},{"text":"        latest_checkpoint = checkpoint_manager.get_latest_checkpoint(self.model_name)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        if latest_checkpoint is None:","action":"LINE_ACTION_INSERT"},{"text":"            raise FileNotFoundError(f\"No checkpoint found for model '{self.model_name}'\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        checkpoint = torch.load(latest_checkpoint)","action":"LINE_ACTION_INSERT"},{"text":"        model_config = LSTMVAEConfig(**checkpoint[\"config\"])","action":"LINE_ACTION_INSERT"},{"text":"        model = LSTMVAE(model_config)","action":"LINE_ACTION_INSERT"},{"text":"        model.load_state_dict(checkpoint[\"model_state_dict\"])","action":"LINE_ACTION_INSERT"},{"text":"        model.eval()","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        self._model_cache[self.model_name] = model","action":"LINE_ACTION_INSERT"},{"text":"        return model","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def predict(self, sequences: np.ndarray) -> np.ndarray:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Predicts anomaly scores for a batch of sequences.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            sequences (np.ndarray): A batch of sequences with shape (batch_size, seq_len, input_dim).","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            np.ndarray: Anomaly scores for each sequence in the batch.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            ValueError: If the input has an invalid shape or contains NaN/Inf values.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        if not isinstance(sequences, np.ndarray) or sequences.ndim != 3:","action":"LINE_ACTION_INSERT"},{"text":"            raise ValueError(\"Input must be a 3D NumPy array of shape (batch_size, seq_len, input_dim)\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        if np.isnan(sequences).any() or np.isinf(sequences).any():","action":"LINE_ACTION_INSERT"},{"text":"            raise ValueError(\"Input contains NaN or Inf values\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        with torch.no_grad():","action":"LINE_ACTION_INSERT"},{"text":"            sequences_tensor = torch.from_numpy(sequences).float()","action":"LINE_ACTION_INSERT"},{"text":"            reconstructed_sequences, _, _ = self.model(sequences_tensor)","action":"LINE_ACTION_INSERT"},{"text":"            reconstruction_error = self._calculate_reconstruction_error(sequences_tensor, reconstructed_sequences)","action":"LINE_ACTION_INSERT"},{"text":"            return reconstruction_error.numpy()","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    @staticmethod","action":"LINE_ACTION_INSERT"},{"text":"    def _calculate_reconstruction_error(original: torch.Tensor, reconstructed: torch.Tensor) -> torch.Tensor:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Calculates the reconstruction error between the original and reconstructed sequences.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            original (torch.Tensor): The original sequences.","action":"LINE_ACTION_INSERT"},{"text":"            reconstructed (torch.Tensor): The reconstructed sequences.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            torch.Tensor: The reconstruction error for each sequence.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        return torch.mean((original - reconstructed) ** 2, dim=[1, 2])","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def handle_variable_length_sequences(self, sequences: List[np.ndarray]) -> List[np.ndarray]:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Handles a list of variable-length sequences by padding them to the same length.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            sequences (List[np.ndarray]): A list of sequences, where each sequence can have a different length.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            List[np.ndarray]: A list of padded sequences.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        max_len = max(len(seq) for seq in sequences)","action":"LINE_ACTION_INSERT"},{"text":"        padded_sequences = [np.pad(seq, ((0, max_len - len(seq)), (0, 0)), 'constant') for seq in sequences]","action":"LINE_ACTION_INSERT"},{"text":"        return padded_sequences","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"}]}]}}}
