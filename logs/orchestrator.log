r, VAETrainer)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_train_epoch(trainer, mock_model):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Test a single training epoch.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    epoch = 1","action":"LINE_ACTION_INSERT"},{"text":"    loss = trainer.train_epoch(epoch)","action":"LINE_ACTION_INSERT"},{"text":"    assert isinstance(loss, float)","action":"LINE_ACTION_INSERT"},{"text":"    assert loss > 0","action":"LINE_ACTION_INSERT"},{"text":"    assert trainer.optimizer.zero_grad.called","action":"LINE_ACTION_INSERT"},{"text":"    assert mock_model.loss_function.called","action":"LINE_ACTION_INSERT"},{"text":"    assert trainer.optimizer.step.called","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_validate(trainer, mock_model):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Test a single validation run.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    epoch = 1","action":"LINE_ACTION_INSERT"},{"text":"    loss = trainer.validate(epoch)","action":"LINE_ACTION_INSERT"},{"text":"    assert isinstance(loss, float)","action":"LINE_ACTION_INSERT"},{"text":"    assert loss > 0","action":"LINE_ACTION_INSERT"},{"text":"    assert mock_model.loss_function.called","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"@patch('src.models.training.VAETrainer.validate', return_value=0.1)","action":"LINE_ACTION_INSERT"},{"text":"@patch('src.models.training.VAETrainer.train_epoch', return_value=0.2)","action":"LINE_ACTION_INSERT"},{"text":"def test_train_loop_and_early_stopping(mock_train_epoch, mock_validate, trainer):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Test the main training loop and early stopping.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    # Test early stopping","action":"LINE_ACTION_INSERT"},{"text":"    mock_validate.side_effect = [0.5, 0.6, 0.7, 0.8]","action":"LINE_ACTION_INSERT"},{"