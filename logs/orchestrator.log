"action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def plot_anomaly_timeline(anomalies_df: pd.DataFrame, threshold: float):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Generates an anomaly timeline with color-coded severity.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    def assign_color(score):","action":"LINE_ACTION_INSERT"},{"text":"        if score > 0.7:","action":"LINE_ACTION_INSERT"},{"text":"            return 'red'","action":"LINE_ACTION_INSERT"},{"text":"        elif score > 0.3:","action":"LINE_ACTION_INSERT"},{"text":"            return 'yellow'","action":"LINE_ACTION_INSERT"},{"text":"        else:","action":"LINE_ACTION_INSERT"},{"text":"            return 'green'","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    anomalies_df['color'] = anomalies_df['anomaly_score'].apply(assign_color)","action":"LINE_ACTION_INSERT"},{"text":"    fig = px.scatter(anomalies_df, x='timestamp', y='anomaly_score', color='color',","action":"LINE_ACTION_INSERT"},{"text":"                     title='Anomaly Score Timeline')","action":"LINE_ACTION_INSERT"},{"text":"    return fig","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"@st.cache_data","action":"LINE_ACTION_INSERT"},{"text":"def query_sensor_readings(tenant_id: int, greenhouse_id: int, start_date, end_date):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Queries sensor readings from the database and returns a DataFrame.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    readings = get_sensor_readings(tenant_id, greenhouse_id, start_date, end_date)","action":"LINE_ACTION_INSERT"},{"text":"    return pd.DataFrame([r.__dict__ for r in readings])","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"}]}]}}}
