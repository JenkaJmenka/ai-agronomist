"LINE_ACTION_INSERT"},{"text":"    reads raw data streams into Pandas, standardizes column structures to the","action":"LINE_ACTION_INSERT"},{"text":"    canonical sensor schema (UTC timestamps and numeric measurements), and performs","action":"LINE_ACTION_INSERT"},{"text":"    data quality checks.","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def __init__(self, config: Dict[str, Any]):","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Initializes the CSV data adapter with configuration.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            config: A dictionary containing adapter parameters:","action":"LINE_ACTION_INSERT"},{"text":"                    - 'filepath' (or 'file_path'): Path to the CSV file.","action":"LINE_ACTION_INSERT"},{"text":"                    - 'column_mapping': Map from raw CSV columns to canonical columns.","action":"LINE_ACTION_INSERT"},{"text":"                    - 'read_params': Optional pass-through kwargs for pd.read_csv().","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        super().__init__(config)","action":"LINE_ACTION_INSERT"},{"text":"        self._connected: bool = False","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    @property","action":"LINE_ACTION_INSERT"},{"text":"    def name(self) -> str:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Returns the vendor/adapter identification name.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        return \"csv\"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def connect(self) -> None:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Establishes a connection to the CSV file by verifying its existence.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            DataSourceConnectionError: If the filepath is missing or the file cannot be found.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        filepath = self.config.get(\"filepath\") or self.config.get(\"file_path\")","action":"LINE_ACTION_INSERT"},{"text":"        if not filepath:","action":"LINE_ACTION_INSERT"},{"text":"            raise DataSourceConnectionError(\"Filepath not specified in config.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        # If it's a string path, ensure it exists on the filesystem","action":"LINE_ACTION_INSERT"},{"text":"        if isinstance(filepath, str):","action":"LINE_ACTION_INSERT"},{"text":"            if not os.path.exists(filepath):","action":"LINE_ACTION_INSERT"},{"text":"                raise DataSourceConnectionError(f\"CSV file not found at path: {filepath}\")","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        self._connected = True","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def disconnect(self) -> None:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Gracefully terminates the virtual connection and resets internal state.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        self._connected = False","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def read(self) -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Reads raw sensor readings from the configured CSV file.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            pd.DataFrame: Raw sensor data direct from the CSV.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            DataReadError: If the virtual connection is active but read operation fails","action":"LINE_ACTION_INSERT"},{"text":"                           or if file-parsing error is encountered.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        if not self._connected:","action":"LINE_ACTION_INSERT"},{"text":"            raise DataReadError(\"Adapter is not connected. Call connect() first.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        filepath = self.config.get(\"filepath\") or self.config.get(\"file_path\")","action":"LINE_ACTION_INSERT"},{"text":"        if not filepath:","action":"LINE_ACTION_INSERT"},{"text":"            raise DataReadError(\"Filepath not specified in config.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        try:","action":"LINE_ACTION_INSERT"},{"text":"            read_params = self.config.get(\"read_params\", {})","action":"LINE_ACTION_INSERT"},{"text":"            df = pd.read_csv(filepath, **read_params)","action":"LINE_ACTION_INSERT"},{"text":"            return df","action":"LINE_ACTION_INSERT"},{"text":"        except Exception as e:","action":"LINE_ACTION_INSERT"},{"text":"            raise DataReadError(f\"Failed to read raw CSV data: {str(e)}\") from e","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def normalize(self, data: pd.DataFrame) -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Transforms the raw CSV DataFrame structure to standard canonical schema formatting:","action":"LINE_ACTION_INSERT"},{"text":"        renaming column headings, converting timestamps to timezone-aware UTC, and casting","action":"LINE_ACTION_INSERT"},{"text":"        measurement columns to float64.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            data: Raw DataFrame direct from the read operation.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            pd.DataFrame: A normalized, ordered DataFrame containing schema columns:","action":"LINE_ACTION_INSERT"},{"text":"                          ['timestamp', 'temperature', 'humidity', 'co2', 'light']","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            NormalizationError: If required mapping columns are absent, or type-conversion fails.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        if data is None:","action":"LINE_ACTION_INSERT"},{"text":"            raise NormalizationError(\"Cannot normalize a None DataFrame.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        df = data.copy()","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        # Rename columns using a provided raw-to-canonical mapping","action":"LINE_ACTION_INSERT"},{"text":"        column_mapping = self.config.get(\"column_mapping\")","action":"LINE_ACTION_INSERT"},{"text":"        if column_mapping:","action":"LINE_ACTION_INSERT"},{"text":"            df = df.rename(columns=column_mapping)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        # Verify that all required canonical columns are present in the dataframe","action":"LINE_ACTION_INSERT"},{"text":"        required_columns = [\"timestamp\", \"temperature\", \"humidity\", \"co2\", \"light\"]","action":"LINE_ACTION_INSERT"},{"text":"        for col in required_columns:","action":"LINE_ACTION_INSERT"},{"text":"            if col not in df.columns:","action":"LINE_ACTION_INSERT"},{"text":"                raise NormalizationError(","action":"LINE_ACTION_INSERT"},{"text":"                    f\"Missing expected canonical column: '{col}' (check your column_mapping)\"","action":"LINE_ACTION_INSERT"},{"text":"                )","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        # Normalize the 'timestamp' column to datetime64[ns, UTC]","action":"LINE_ACTION_INSERT"},{"text":"        try:","action":"LINE_ACTION_INSERT"},{"text":"            df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"])","action":"LINE_ACTION_INSERT"},{"text":"            if df[\"timestamp\"].dt.tz is None:","action":"LINE_ACTION_INSERT"},{"text":"                # Naive datetime: assume UTC as standard and localize it","action":"LINE_ACTION_INSERT"},{"text":"                df[\"timestamp\"] = df[\"timestamp\"].dt.tz_localize(\"UTC\")","action":"LINE_ACTION_INSERT"},{"text":"            else:","action":"LINE_ACTION_INSERT"},{"text":"                # Timezone-aware: convert strictly to UTC","action":"LINE_ACTION_INSERT"},{"text":"                df[\"timestamp\"] = df[\"timestamp\"].dt.tz_convert(\"UTC\")","action":"LINE_ACTION_INSERT"},{"text":"        except Exception as e:","action":"LINE_ACTION_INSERT"},{"text":"            raise NormalizationError(","action":"LINE_ACTION_INSERT"},{"text":"                f\"Failed to normalize 'timestamp' column to UTC timezone: {str(e)}\"","action":"LINE_ACTION_INSERT"},{"text":"            ) from e","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        # Normalize physical sensor readings to float64 numerical values","action":"LINE_ACTION_INSERT"},{"text":"        for col in [\"temperature\", \"humidity\", \"co2\", \"light\"]:","action":"LINE_ACTION_INSERT"},{"text":"            try:","action":"LINE_ACTION_INSERT"},{"text":"                df[col] = pd.to_numeric(df[col]).astype(\"float64\")","action":"LINE_ACTION_INSERT"},{"text":"            except Exception as e:","action":"LINE_ACTION_INSERT"},{"text":"                raise NormalizationError(","action":"LINE_ACTION_INSERT"},{"text":"                    f\"Failed to coerce column '{col}' to float64 numeric type: {str(e)}\"","action":"LINE_ACTION_INSERT"},{"text":"                ) from e","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        # Return a clean DataFrame containing exactly the canonical column sequence","action":"LINE_ACTION_INSERT"},{"text":"        return df[required_columns]","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def validate(self, data: pd.DataFrame) -> bool:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Performs data quality and schema compliance validation checks on normalized DataFrame.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            data: Normalized DataFrame containing canonical structure.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            bool: True if DataFrame matches canonical structures and complies with physical boundaries.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            DataValidationError: If verification fails (e.g., missing columns, empty reading sequence,","action":"LINE_ACTION_INSERT"},{"text":"                                 timestamps without UTC, non-numeric values, or out-of-bounds readings).","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        # Leverage the robust utility validator provided by the base class","action":"LINE_ACTION_INSERT"},{"text":"        return self.validate_canonical_schema(data)","action":"LINE_ACTION_INSERT"}]}]}}}
