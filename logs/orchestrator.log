{"text":"if DATABASE_URL.startswith(\"sqlite\"):","action":"LINE_ACTION_INSERT"},{"text":"    connect_args[\"check_same_thread\"] = False","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"# Create AsyncEngine","action":"LINE_ACTION_INSERT"},{"text":"engine = create_async_engine(","action":"LINE_ACTION_INSERT"},{"text":"    DATABASE_URL,","action":"LINE_ACTION_INSERT"},{"text":"    connect_args=connect_args,","action":"LINE_ACTION_INSERT"},{"text":"    echo=False,  # Set to True for verbose SQL query logging","action":"LINE_ACTION_INSERT"},{"text":")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"# Async session factory","action":"LINE_ACTION_INSERT"},{"text":"AsyncSessionLocal = async_sessionmaker(","action":"LINE_ACTION_INSERT"},{"text":"    bind=engine,","action":"LINE_ACTION_INSERT"},{"text":"    class_=AsyncSession,","action":"LINE_ACTION_INSERT"},{"text":"    expire_on_commit=False,","action":"LINE_ACTION_INSERT"},{"text":")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"class Base(DeclarativeBase):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Base class for all SQLAlchemy ORM models.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    pass","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"async def get_db() -> AsyncGenerator[AsyncSession, None]:","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    Dependency injection generator to yield an asynchronous database session.","action":"LINE_ACTION_INSERT"},{"text":"    Automatically handles commit, rollback on exceptions, and closing on completion.","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    async with AsyncSessionLocal() as session:","action":"LINE_ACTION_INSERT"},{"text":"        try:","action":"LINE_ACTION_INSERT"},{"text":"            yield session","action":"LINE_ACTION_INSE