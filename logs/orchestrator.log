ion":"LINE_ACTION_INSERT"},{"text":"    return anomalies[anomalies[\"reconstruction_error\"] > threshold]","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def clip_and_scale_anomalies(","action":"LINE_ACTION_INSERT"},{"text":"    anomalies: pd.DataFrame, scaling_factor: float","action":"LINE_ACTION_INSERT"},{"text":") -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Clips anomaly scores and scales them for visualization.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    anomalies[\"clipped_error\"] = np.clip(anomalies[\"reconstruction_error\"], 0, None)","action":"LINE_ACTION_INSERT"},{"text":"    anomalies[\"scaled_error\"] = anomalies[\"clipped_error\"] * scaling_factor","action":"LINE_ACTION_INSERT"},{"text":"    return anomalies","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def get_high_anomaly_timestamps(","action":"LINE_ACTION_INSERT"},{"text":"    anomalies: pd.DataFrame, threshold: float","action":"LINE_ACTION_INSERT"},{"text":") -> List[Dict[str, Any]]:","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Filters for high-severity anomalies and returns a list of dictionaries.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    high_anomalies = anomalies[anomalies[\"reconstruction_error\"] > threshold]","action":"LINE_ACTION_INSERT"},{"text":"    return high_anomalies.to_dict(\"records\")","action":"LINE_ACTION_INSERT"},{"text":"```","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"## 2. Updated `src/config.py`","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"The configuration file was updated to include new parameters for anomaly detection.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"```python","action":"LINE_ACTION_INSERT"},{"text":"# =============================================================================","action":"LINE_ACTION_INSERT"},{"text":"# Anomaly Detection and Post-Processing","action":"LINE_ACTION_INSERT"},{"text":"# =============================================================================","action":"LINE_ACTION_INSERT"},{"text":"ANOMALY_THRESHOLD: float = 0.8","action":"LINE_ACTION_INSERT"},{"text":"ANOMALY_SCALING_FACTOR: float = 2.0","action":"LINE_ACTION_INSERT"},{"text":"```","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"## 3. Updated `src/api/routes/inference.py`","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"The inference route was updated to use the new post-processing functions and configuration values.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"```python","action":"LINE_ACTION_INSERT"},{"text":"from fastapi import APIRouter, HTTPException, Depends","action":"LINE_ACTION_INSERT"},{"text":"from src.api.schemas.sensor_data import InferenceRequest, InferenceResponse","action":"LINE_ACTION_INSERT"},{"text":"from src.db.session import get_db","action":"LINE_ACTION_INSERT"},{"text":"from sqlalchemy.ext.asyncio import AsyncSession","action":"LINE_ACTION_INSERT"},{"text":"from sqlalchemy.future import select","action":"LINE_ACTION_INSERT"},{"text":"from src.db.models import SensorReading","action":"LINE_ACTION_INSERT"},{"text":"from src.models.inference import AnomalyDetector","action":"LINE_ACTION_INSERT"},{"text":"from src.models.model_registry import ModelRegistry","action":"LINE_ACTION_INSERT"},{"text":"from typing import List, Dict, Any, Optional","action":"LINE_ACTION_INSERT"},{"text":"from datetime import datetime, timezone","action":"LINE_ACTION_INSERT"},{"text":"import numpy as np","action":"LINE_ACTION_INSERT"},{"text":"from fastapi import UploadFile, File, Form","action":"LINE_ACTION_INSERT"},{"text":"import tempfile","action":"LINE_ACTION_INSERT"},{"text":"import os","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"from src.vendors.csv_adapter import CSVAdapter","action":"LINE_ACTION_INSERT"},{"text":"from src.models.data_utils import preprocess_sequences, normalize_data, SENSOR_RANGES","action":"LINE_ACTION_INSERT"},{"text":"from src.models.postprocessing import (","action":"LINE_ACTION_INSERT"},{"text":"    map_timestamp_to_anomaly,","action":"LINE_ACTION_INSERT"},{"text":"    clip_and_scale_anomalies,","action":"LINE_ACTION_INSERT"},{"text":"    get_high_anomaly_timestamps,","action":"LINE_ACTION_INSERT"},{"text":")","action":"LINE_ACTION_INSERT"},{"text":"from src.config import ANOMALY_THRESHOLD, ANOMALY_SCALING_FACTOR","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"router = APIRouter()","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"@router.post(\"/inference\", response_model=InferenceResponse)","action":"LINE_ACTION_INSERT"},{"text":"async def run_inference(","action":"LINE_ACTION_INSERT"},{"text":"    request: InferenceRequest,","action":"LINE_ACTION_INSERT"},{"text":"    db: AsyncSession = Depends(get_db)","action":"LINE_ACTION_INSERT"},{"text":"):","action":"LINE_ACTION_INSERT"},{"text":"    seqs = request.sequences","action":"LINE_ACTION_INSERT"},{"text":"    if not seqs:","action":"LINE_ACTION_INSERT"},{"text":"        raise HTTPException(status_code=400, detail=\"Empty sequences\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Resolve active model for customer","action":"LINE_ACTION_INSERT"},{"text":"    registry = ModelRegistry(db)","action":"LINE_ACTION_INSERT"},{"text":"    active_model_info = await registry.get_active_model(request.tenant_id)","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    checkpoint_path = None","action":"LINE_ACTION_INSERT"},{"text":"    model_id_used = \"baseline_v1\"","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    if active_model_info:","action":"LINE_ACTION_INSERT"},{"text":"        checkpoint_path = active_model_info[\"checkpoint_path\"]","action":"LINE_ACTION_INSERT"},{"text":"        model_id_used = active_model_info[\"model_id\"]","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"    try:","action":"LINE_ACTION_INSERT"},{"text":"        detector = AnomalyDetector(checkpoint_path=checkpoint_path)","action":"LINE_ACTION_INSERT"},{"text":"    except Exception as e:","action":"LINE_ACTION_INSERT"},{"text":"        raise HTTPException(status_code=503, detail=f\"Failed to initialize model: {e}\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    try:","action":"LINE_ACTION_INSERT"},{"text":"        # Expected shape (batch, seq_len, input_dim) -> (batch, 20, 4)","action":"LINE_ACTION_INSERT"},{"text":"        np_seqs = [np.array(seq, dtype=np.float32) for seq in seqs]","action":"LINE_ACTION_INSERT"},{"text":"        raw_scores = detector.predict_batch(np_seqs)","action":"LINE_ACTION_INSERT"},{"text":"        # Scale or clip raw reconstruction errors to [0, 1] range to satisfy Pydantic Schema","action":"LINE_ACTION_INSERT"},{"text":"        batch_scores = np.clip(raw_scores / ANOMALY_SCALING_FACTOR, 0.0, 1.0)","action":"LINE_ACTION_INSERT"},{"text":"    except Exception as e:","action":"LINE_ACTION_INSERT"},{"text":"        raise HTTPException(status_code=400, detail=f\"Inference failed: {str(e)}\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    anomalies_detected = int((batch_scores > ANOMALY_THRESHOLD).sum())","action":"LINE_ACTION_INSERT"},{"text":"    high_anomalies = [","action":"LINE_ACTION_INSERT"},{"text":"        {\"sequence_index\": i, \"score\": float(s), \"timestamp\": datetime.now(timezone.utc).isoformat()}","action":"LINE_ACTION_INSERT"},{"text":"        for i, s in enumerate(batch_scores)","action":"LINE_ACTION_INSERT"},{"text":"        if s > ANOMALY_THRESHOLD","action":"LINE_ACTION_INSERT"},{"text":"    ]","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    # Persist scores to the matching database records for this tenant/greenhouse","action":"LINE_ACTION_INSERT"},{"text":"    stmt = select(SensorReading).where(","action":"LINE_ACTION_INSERT"},{"text":"        SensorReading.tenant_id == request.tenant_id,","action":"LINE_ACTION_INSERT"},{"text":"        SensorReading.greenhouse_id == request.greenhouse_id,","action":"LINE_ACTION_INSERT"},{"text":"    ).order_by(SensorReading.timestamp.desc()).limit(len(batch_scores))","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    result = await db.execute(stmt)","action":"LINE_ACTION_INSERT"},{"text":"    records = result.scalars().all()","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    # We update records with anomaly scores starting from the matching indices","action":"LINE_ACTION_INSERT"},{"text":"    for idx, record in enumerate(reversed(records)):","action":"LINE_ACTION_INSERT"},{"text":"        if idx < len(batch_scores):","action":"LINE_ACTION_INSERT"},{"text":"            record.anomaly_score = float(batch_scores[idx])","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    try:","action":"LINE_ACTION_INSERT"},{"text":"        await db.commit()","action":"LINE_ACTION_INSERT"},{"text":"    except Exception as e:","action":"LINE_ACTION_INSERT"},{"text":"        await db.rollback()","action":"LINE_ACTION_INSERT"},{"text":"        raise HTTPException(status_code=500, detail=f\"Failed to persist anomaly scores: {str(e)}\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    return InferenceResponse(","action":"LINE_ACTION_INSERT"},{"text":"        tenant_id=request.tenant_id,","action":"LINE_ACTION_INSERT"},{"text":"        greenhouse_id=request.greenhouse_id,","action":"LINE_ACTION_INSERT"},{"text":"        sequences_processed=len(seqs),","action":"LINE_ACTION_INSERT"},{"text":"        anomalies_detected=anomalies_detected,","action":"LINE_ACTION_INSERT"},{"text":"        anomaly_scores=batch_scores.tolist(),","action":"LINE_ACTION_INSERT"},{"text":"        high_anomalies=high_anomalies","action":"LINE_ACTION_INSERT"},{"text":"    )","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"@router.post(\"/inference/upload\")","action":"LINE_ACTION_INSERT"},{"text":"async def run_inference_from_csv(","action":"LINE_ACTION_INSERT"},{"text":"    tenant_id: str = Form(...),","action":"LINE_ACTION_INSERT"},{"text":"    greenhouse_id: str = Form(default=\"default\"),","action":"LINE_ACTION_INSERT"},{"text":"    file: UploadFile = File(...),","action":"LINE_ACTION_INSERT"},{"text":"    db: AsyncSession = Depends(get_db)","action":"LINE_ACTION_INSERT"},{"text":"):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    Directly runs inference on an uploaded CSV file without persisting the raw data,","action":"LINE_ACTION_INSERT"},{"text":"    returning the anomaly scores and a list of high anomaly items.","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    if not file.filename.endswith(\".csv\"):","action":"LINE_ACTION_INSERT"},{"text":"        raise HTTPException(status_code=400, detail=\"Only CSV files are supported.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    content = await file.read()","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    with tempfile.NamedTemporaryFile(delete=False, suffix=\".csv\") as tmp:","action":"LINE_ACTION_INSERT"},{"text":"        tmp.write(content)","action":"LINE_ACTION_INSERT"},{"text":"        tmp_path = tmp.name","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    try:","action":"LINE_ACTION_INSERT"},{"text":"        adapter = CSVAdapter({\"filepath\": tmp_path})","action":"LINE_ACTION_INSERT"},{"text":"        df = adapter.get_data()","action":"LINE_ACTION_INSERT"},{"text":"    except Exception as e:","action":"LINE_ACTION_INSERT"},{"text":"        os.unlink(tmp_path)","action":"LINE_ACTION_INSERT"},{"text":"        raise HTTPException(status_code=422, detail=f\"Invalid CSV format: {e}\")","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    os.unlink(tmp_path)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    if df.empty:","action":"LINE_ACTION_INSERT"},{"text":"        raise HTTPException(status_code=400, detail=\"Uploaded CSV contains no valid data.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Extract required columns for inference: temperature, humidity, co2, light","action":"LINE_ACTION_INSERT"},{"text":"    try:","action":"LINE_ACTION_INSERT"},{"text":"        raw_data = df[[\"temperature\", \"humidity\", \"co2\", \"light\"]].to_numpy()","action":"LINE_ACTION_INSERT"},{"text":"    except KeyError as e:","action":"LINE_ACTION_INSERT"},{"text":"        raise HTTPException(status_code=422, detail=f\"Missing required columns: {e}\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Normalize data using standard ranges","action":"LINE_ACTION_INSERT"},{"text":"    norm_data = normalize_data(raw_data, SENSOR_RANGES)","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    try:","action":"LINE_ACTION_INSERT"},{"text":"        sequences = preprocess_sequences(norm_data, seq_len=20)","action":"LINE_ACTION_INSERT"},{"text":"    except ValueError as e:","action":"LINE_ACTION_INSERT"},{"text":"        raise HTTPException(status_code=422, detail=str(e))","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Resolve active model for customer","action":"LINE_ACTION_IN