{"text":"def test_workflow_with_vendor_adapter(test_client, test_database: Session, sample_csv_file):","action":"LINE_ACTION_DELETE"},{"text":"    # This test simulates the vendor adapter fetching data that is then uploaded.","action":"LINE_ACTION_DELETE"},{"text":"    adapter = CSVAdapter()","action":"LINE_ACTION_DELETE"},{"text":"    # Let's pretend the adapter reads our sample file","action":"LINE_ACTION_DELETE"},{"text":"    df = adapter.fetch_data(file_path=sample_csv_file)","action":"LINE_ACTION_DELETE"},{"text":"    res_inference = test_client.post(","action":"LINE_ACTION_INSERT"},{"text":"        \"/api/inference\",","action":"LINE_ACTION_INSERT"},{"text":"        json={\"sequences\": sequences, \"tenant_id\": tenant_id, \"greenhouse_id\": \"main_zone\"}","action":"LINE_ACTION_INSERT"},{"text":"    )","action":"LINE_ACTION_INSERT"},{"text":"    assert res_inference.status_code == status.HTTP_200_OK","action":"LINE_ACTION_INSERT"},{"text":"    assert len(res_inference.json()[\"anomaly_scores\"]) == 10","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Query the database to verify the latest 10 records received the anomaly scores","action":"LINE_ACTION_INSERT"},{"text":"    stmt_scores = (","action":"LINE_ACTION_INSERT"},{"text":"        select(SensorReading)","action":"LINE_ACTION_INSERT"},{"text":"        .where(SensorReading.tenant_id == tenant_id, SensorReading.anomaly_score != None)","action":"LINE_ACTION_INSERT"},{"text":"    )","action":"LINE_ACTION_INSERT"},{"text":"    db_scores_res = await test_database.execute(stmt_scores)","action":"LINE_ACTION_INSERT"},{"text":"    scored_records = db_scores_res.scalars().all()","action":"LINE_ACTION_INSERT"},{"text":"    assert len(scored_records) == 10","action":"LINE_ACTION_INSERT"},{"text":"    assert all(r.anomaly_score == pytest.approx(0.75) for r in scored_records)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # -----------------