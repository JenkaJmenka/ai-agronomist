tions for anticipated","action":"LINE_ACTION_INSERT"},{"text":"      errors (e.g., `FileNotFoundError`, `DataValidationError`,","action":"LINE_ACTION_INSERT"},{"text":"      `NormalizationError`).","action":"LINE_ACTION_INSERT"},{"text":"    - The calling code is responsible for catching these exceptions and","action":"LINE_ACTION_INSERT"},{"text":"      implementing appropriate retry logic, logging, or alerting.","action":"LINE_ACTION_INSERT"},{"text":"    - Vendor-specific exceptions should be wrapped in generic exceptions","action":"LINE_ACTION_INSERT"},{"text":"      defined in a central `src/vendors/exceptions.py` module to decouple","action":"LINE_ACTION_INSERT"},{"text":"      the core application from vendor details. For example, a vendor's","action":"LINE_ACTION_INSERT"},{"text":"      `VendorAPIError` could be caught and re-raised as `DataSourceApiError`.","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def __init__(self, config: Dict[str, Any]):","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Initializes the adapter with vendor-specific configuration.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            config: A dictionary containing configuration parameters such as","action":"LINE_ACTION_INSERT"},{"text":"                    API keys, file paths, or database credentials.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        self.config = config","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    @abstractmethod","action":"LINE_ACTION_INSERT"},{"text":"    def read(self) -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Reads data from the source and returns it as a pandas DataFrame.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        This method should handle the specifics of connecting to the data","action":"LINE_ACTION_INSERT"},{"text":"        source, whether it's a file, a database, or a web API.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            A pandas DataFrame containing the raw sensor data.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            FileNotFoundError: If a specified file path does not exist.","action":"LINE_ACTION_INSERT"},{"text":"            ConnectionError: If there is a problem connecting to an API or database.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        pass","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    @abstractmethod","action":"LINE_ACTION_INSERT"},{"text":"    def normalize(self, data: pd.DataFrame) -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Normalizes the raw data to the canonical schema.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        This includes renaming columns, converting data types, and scaling","action":"LINE_ACTION_INSERT"},{"text":"        values to a standard range (e.g., [0, 1]). Normalization ensures","action":"LINE_ACTION_INSERT"},{"text":"        that the data is in a consistent format for model consumption.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            data: The raw data DataFrame returned by the read() method.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            A pandas DataFrame with the normalized data.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            KeyError: If a required column is missing from the raw data.","action":"LINE_ACTION_INSERT"},{"text":"            ValueError: If data conversion or scaling fails.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        pass","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    @abstractmethod","action":"LINE_ACTION_INSERT"},{"text":"    def validate(self, data: pd.DataFrame) -> bool:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Validates the normalized data against a set of rules.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Validation checks could include ensuring values are within expected","action":"LINE_ACTION_INSERT"},{"text":"        physical ranges, checking for missing data, or verifying timestamps.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            data: The normalized data DataFrame.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            True if the data is valid, otherwise raises a `DataValidationError`.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            DataValidationError: If the data fails validation checks.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        pass","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"}]}]}}}
