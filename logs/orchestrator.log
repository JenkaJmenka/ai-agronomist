======================================================","action":"LINE_ACTION_NONE"},{"text":"# LSTM-VAE Model Architecture","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# The number of features per time step (temperature, humidity, CO2, light)","action":"LINE_ACTION_NONE"},{"text":"INPUT_DIM: int = 4","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# The length of each input sequence","action":"LINE_ACTION_NONE"},{"text":"SEQ_LEN: int = 20","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# The dimensionality of the latent space bottleneck","action":"LINE_ACTION_NONE"},{"text":"LATENT_DIM: int = 8","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# List of dimensions for the hidden LSTM layers","action":"LINE_ACTION_NONE"},{"text":"HIDDEN_DIMS: List[int] = [64, 32]","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Derived from HIDDEN_DIMS","action":"LINE_ACTION_NONE"},{"text":"NUM_LAYERS: int = len(HIDDEN_DIMS)","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Dropout probability for regularization","action":"LINE_ACTION_NONE"},{"text":"DROPOUT_RATE: float = 0.2","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Weight of the KL divergence term in the VAE loss function","action":"LINE_ACTION_NONE"},{"text":"BETA: float = 0.1","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Training Hyperparameters","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Number of training samples processed in one iteration","action":"LINE_ACTION_NONE"},{"text":"BATCH_SIZE: int = 32","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Initial learning rate for the optimizer","action":"LINE_ACTION_NONE"},{"text":"LEARNING_RATE: float = 1e-3","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Total number of training epochs","action":"LINE_ACTION_NONE"},{"text":"NUM_EPOCHS: int = 100","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# L2 regularization coefficient applied by the optimizer","action":"LINE_ACTION_NONE"},{"text":"WEIGHT_DECAY: float = 1e-5","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Number of epochs without validation improvement before stopping early","action":"LINE_ACTION_NONE"},{"text":"EARLY_STOPPING_PATIENCE: int = 10","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Proportion of data held out for validation during training","action":"LINE_ACTION_NONE"},{"text":"VALIDATION_SPLIT: float = 0.2","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Filesystem Paths","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Directories for model checkpoints, generated data, and training logs","action":"LINE_ACTION_NONE"},{"text":"PATHS: dict = {","action":"LINE_ACTION_NONE"},{"text":"    \"checkpoint_dir\": \"models/checkpoints/\",","action":"LINE_ACTION_NONE"},{"text":"    \"data_dir\": \"data/synthetic/\",","action":"LINE_ACTION_NONE"},{"text":"    \"log_dir\": \"logs/tensorboard/\",","action":"LINE_ACTION_NONE"},{"text":"}","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Synthetic Data Generation & Normalization","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Total number of synthetic sequences to generate","action":"LINE_ACTION_NONE"},{"text":"NUM_SAMPLES: int = 1000","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# The range for normalized sensor data [0, 1]","action":"LINE_ACTION_NONE"},{"text":"NORM_MIN: float = 0.0","action":"LINE_ACTION_NONE"},{"text":"NORM_MAX: float = 1.0","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Physical bounds for sensor readings (unnormalized)","action":"LINE_ACTION_NONE"},{"text":"TEMP_RANGE: Tuple[float, float] = (20.0, 30.0)      # Celsius","action":"LINE_ACTION_NONE"},{"text":"HUMIDITY_RANGE: Tuple[float, float] = (50.0, 80.0)  # Percentage","action":"LINE_ACTION_NONE"},{"text":"CO2_RANGE: Tuple[float, float] = (300.0, 500.0)     # ppm","action":"LINE_ACTION_NONE"},{"text":"LIGHT_RANGE: Tuple[float, float] = (0.0, 1000.0)    # lux","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Metadata for sensor identification","action":"LINE_ACTION_NONE"},{"text":"SENSOR_NAMES: List[str] = [\"temperature\", \"humidity\", \"co2\", \"light\"]","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Synthetic Signal Generation Parameters","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Tunable signal-shape and noise constants used by SyntheticDataGenerator to","action":"LINE_ACTION_NONE"},{"text":"# build the per-channel diurnal/trend signals plus Gaussian sensor noise.","action":"LINE_ACTION_NONE"},{"text":"# These are externalized here so the generator contains no magic numbers.","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Divisor applied to a channel's (high - low) span to derive its sine amplitude.","action":"LINE_ACTION_NONE"},{"text":"AMPLITUDE_DIVISOR: float = 4.0","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Temperature channel: diurnal sine frequency and additive noise std.","action":"LINE_ACTION_NONE"},{"text":"TEMP_SINE_FREQ: float = 0.2","action":"LINE_ACTION_NONE"},{"text":"TEMP_NOISE_STD: float = 0.5","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Humidity channel: inverse-coupling factor to temperature and noise std.","action":"LINE_ACTION_NONE"},{"text":"HUMIDITY_COUPLING_FACTOR: float = 0.5","action":"LINE_ACTION_NONE"},{"text":"HUMIDITY_NOISE_STD: float = 1.0","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# CO2 channel: upward trend slope (per time step) and noise std.","action":"LINE_ACTION_NONE"},{"text":"CO2_TREND_SLOPE: float = 0.1","action":"LINE_ACTION_NONE"},{"text":"CO2_NOISE_STD: float = 5.0","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Light channel: day/night sine amplitude, sine frequency and noise std.","action":"LINE_ACTION_NONE"},{"text":"LIGHT_AMPLITUDE: float = 400.0","action":"LINE_ACTION_NONE"},{"text":"LIGHT_SINE_FREQ: float = 0.1","action":"LINE_ACTION_NONE"},{"text":"LIGHT_NOISE_STD: float = 50.0","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# Moving-average window size used to smooth raw signals into continuous series.","action":"LINE_ACTION_NONE"},{"text":"SMOOTHING_KERNEL_SIZE: int = 3","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# Aggregated Configuration Dictionaries","action":"LINE_ACTION_NONE"},{"text":"# =============================================================================","action":"LINE_ACTION_NONE"},{"text":"# These dicts are derived from the flat constants above and provide a grouped","action":"LINE_ACTION_NONE"},{"text":"# view of the configuration consumed by the model, training, and data layers.","action":"LINE_ACTION_NONE"},{"text":"MODEL_CONFIG: dict = {","action":"LINE_ACTION_NONE"},{"text":"    \"input_dim\": INPUT_DIM,","action":"LINE_ACTION_NONE"},{"text":"    \"hidden_dims\": HIDDEN_DIMS,","action":"LINE_ACTION_NONE"},{"text":"    \"latent_dim\": LATENT_DIM,","action":"LINE_ACTION_NONE"},{"text":"    \"seq_len\": SEQ_LEN,","action":"LINE_ACTION_NONE"},{"text":"    \"beta\": BETA,","action":"LINE_ACTION_NONE"},{"text":"    \"dropout\": DROPOUT_RATE,","action":"LINE_ACTION_NONE"},{"text":"}","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"TRAINING_CONFIG: dict = {","action":"LINE_ACTION_NONE"},{"text":"    \"epochs\": NUM_EPOCHS,","action":"LINE_ACTION_NONE"},{"text":"    \"batch_size\": BATCH_SIZE,","action":"LINE_ACTION_NONE"},{"text":"    \"learning_rate\": LEARNING_RATE,","action":"LINE_ACTION_NONE"},{"text":"    \"weight_decay\": WEIGHT_DECAY,","action":"LINE_ACTION_NONE"},{"text":"    \"early_stopping_patience\": EARLY_STOPPING_PATIENCE,","action":"LINE_ACTION_NONE"},{"text":"    \"validation_split\": VALIDATION_SPLIT,","action":"LINE_ACTION_NONE"},{"text":"}","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"DATA_CONFIG: dict = {","action":"LINE_ACTION_NONE"},{"text":"    \"num_sequences\": NUM_SAMPLES,","action":"LINE_ACTION_NONE"},{"text":"    \"seq_len\": SEQ_LEN,","action":"LINE_ACTION_NONE"},{"text":"    \"input_dim\": INPUT_DIM,","action":"LINE_ACTION_NONE"},{"text":"    \"random_seed\": RANDOM_SEED,","action":"LINE_ACTION_NONE"},{"text":"}","action":"LINE_ACTION_NONE"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"# =========