INSERT"},{"text":"        pass","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # =============================================================================","action":"LINE_ACTION_INSERT"},{"text":"    # Template Methods and Adapter Aliases (Backwards Compatibility)","action":"LINE_ACTION_INSERT"},{"text":"    # =============================================================================","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def read_data(self) -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"Alternative alias for the read() method.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        return self.read()","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def normalize_data(self, raw_data: pd.DataFrame) -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"Alternative alias for the normalize() method.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        return self.normalize(raw_data)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def validate_data(self, df: pd.DataFrame) -> None:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"Alternative alias for the validate() method.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        self.validate(df)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def get_data(self) -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Template orchestrator executing adapter sequence: Connect, Read, Normalize, Validate, Disconnect.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            A validated, normalized Pandas DataFrame conforming to the canonical schema.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            DataSourceConnectionError: Connection failure.","action":"LINE_ACTION_INSERT"},{"text":"            DataReadError: Read failure.","action":"LINE_ACTION_INSERT"},{"text":"            NormalizationError: Transformation failure.","action":"LINE_ACTION_INSERT"},{"text":"            DataValidationError: Data quality check failing.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        self.connect()","action":"LINE_ACTION_INSERT"},{"text":"        try:","action":"LINE_ACTION_INSERT"},{"text":"            raw_data = self.read()","action":"LINE_ACTION_INSERT"},{"text":"            normalized_data = self.normalize(raw_data)","action":"LINE_ACTION_INSERT"},{"text":"            self.validate(normalized_data)","action":"LINE_ACTION_INSERT"},{"text":"            return normalized_data","action":"LINE_ACTION_INSERT"},{"text":"        finally:","action":"LINE_ACTION_INSERT"},{"text":"            self.disconnect()","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    @staticmethod","action":"LINE_ACTION_INSERT"},{"text":"    def validate_canonical_schema(data: pd.DataFrame) -> bool:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Utility static helper to validate a DataFrame against the canonical schema constraints.","action":"LINE_ACTION_INSERT"},{"text":"        Can be used by any concrete adapter in its `validate` method.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            data: The DataFrame to validate.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            True if valid.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            DataValidationError: If any validation rule is violated.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        required_cols = [\"timestamp\", \"temperature\", \"humidity\", \"co2\", \"light\"]","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        # 1. Check for missing columns","action":"LINE_ACTION_INSERT"},{"text":"        for col in required_cols:","action":"LINE_ACTION_INSERT"},{"text":"            if col not in data.columns:","action":"LINE_ACTION_INSERT"},{"text":"                raise DataValidationError(f\"Missing required canonical column: '{col}'\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        # 2. Check for empty dataframe","action":"LINE_ACTION_INSERT"},{"text":"        if data.empty:","action":"LINE_ACTION_INSERT"},{"text":"            raise DataValidationError(\"DataFrame is empty and contains no sensor readings\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        # 3. Check and validate timestamp column","action":"LINE_ACTION_INSERT"},{"text":"        if not pd.api.types.is_datetime64_any_dtype(data[\"timestamp\"]):","action":"LINE_ACTION_INSERT"},{"text":"            raise DataValidationError(\"Column 'timestamp' must be datetime-like (type datetime64)\")","action":"LINE_ACTION_INSERT"},{"text":"            ","action":"LINE_ACTION_INSERT"},{"text":"        try:","action":"LINE_ACTION_INSERT"},{"text":"            if getattr(data[\"timestamp\"].dt, \"tz\", None) is None:","action":"LINE_ACTION_INSERT"},{"text":"                raise DataValidationError(\"Column 'timestamp' must have timezone-aware UTC values\")","action":"LINE_ACTION_INSERT"},{"text":"        except AttributeError:","action":"LINE_ACTION_INSERT"},{"text":"            raise DataValidationError(\"Fail to parse 'timestamp' Series as datetime or access .dt namespace\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        # 4. Check that numerical columns are numeric and within physical bounds:","action":"LINE_ACTION_INSERT"},{"text":"        bounds = {","action":"LINE_ACTION_INSERT"},{"text":"            \"temperature\": (0.0, 50.0),","action":"LINE_ACTION_INSERT"},{"text":"            \"humidity\": (0.0, 100.0),","action":"LINE_ACTION_INSERT"},{"text":"            \"co2\": (0.0, 1000.0),","action":"LINE_ACTION_INSERT"},{"text":"            \"light\": (0.0, 2000.0)","action":"LINE_ACTION_INSERT"},{"text":"        }","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        for col, (min_val, max_val) in bounds.items():","action":"LINE_ACTION_INSERT"},{"text":"            if not pd.api.types.is_numeric_dtype(data[col]):","action":"LINE_ACTION_INSERT"},{"text":"                raise DataValidationError(f\"Column '{col}' must be of numeric type\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"            # Check actual bounds and raise explicit DataValidationError on failure","action":"LINE_ACTION_INSERT"},{"text":"            out_of_bounds_low = data[data[col] < min_val]","action":"LINE_ACTION_INSERT"},{"text":"            out_of_bounds_high = data[data[col] > max_val]","action":"LINE_ACTION_INSERT"},{"text":"            ","action":"LINE_ACTION_INSERT"},{"text":"            if not out_of_bounds_low.empty:","action":"LINE_ACTION_INSERT"},{"text":"                val = out_of_bounds_low[col].iloc[0]","action":"LINE_ACTION_INSERT"},{"text":"                raise DataValidationError(","action":"LINE_ACTION_INSERT"},{"text":"                    f\"Column '{col}' contains values below allowed minimum of {min_val} (found: {val})\"","action":"LINE_ACTION_INSERT"},{"text":"                )","action":"LINE_ACTION_INSERT"},{"text":"            if not out_of_bounds_high.empty:","action":"LINE_ACTION_INSERT"},{"text":"                val = out_of_bounds_high[col].iloc[0]","action":"LINE_ACTION_INSERT"},{"text":"                raise DataValidationError(","action":"LINE_ACTION_INSERT"},{"text":"                    f\"Column '{col}' contains values above allowed maximum of {max_val} (found: {val})\"","action":"LINE_ACTION_INSERT"},{"text":"                )","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        return True","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"# Alias to support AbstractVendorAdapter design naming conventions","action":"LINE_ACTION_INSERT"},{"text":"AbstractVendorAdapter = DataSourceAdapter","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_NONE"}]}]}}}
