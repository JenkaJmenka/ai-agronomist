\"):","action":"LINE_ACTION_INSERT"},{"text":"                files = {\"file\": (uploaded_file_train.name, uploaded_file_train.getvalue(), \"text/csv\")}","action":"LINE_ACTION_INSERT"},{"text":"                data = {\"tenant_id\": tenant_id_train, \"greenhouse_id\": greenhouse_id_train}","action":"LINE_ACTION_INSERT"},{"text":"                try:","action":"LINE_ACTION_INSERT"},{"text":"                    res_upload = requests.post(f\"{API_URL}/api/upload\", files=files, data=data)","action":"LINE_ACTION_INSERT"},{"text":"                    res_upload.raise_for_status()","action":"LINE_ACTION_INSERT"},{"text":"                    st.success(f\"Successfully uploaded {res_upload.json().get('uploaded', 0)} rows.\")","action":"LINE_ACTION_INSERT"},{"text":"                    ","action":"LINE_ACTION_INSERT"},{"text":"                    st.info(\"Triggering model training pipeline...\")","action":"LINE_ACTION_INSERT"},{"text":"                    res_train = requests.post(f\"{API_URL}/api/models/{tenant_id_train}/train\")","action":"LINE_ACTION_INSERT"},{"text":"                    res_train.raise_for_status()","action":"LINE_ACTION_INSERT"},{"text":"                    st.success(\"Training dispatched in the background.\")","action":"LINE_ACTION_INSERT"},{"text":"                    st.json(res_train.json())","action":"LINE_ACTION_INSERT"},{"text":"                except requests.exceptions.RequestException as e:","action":"LINE_ACTION_INSERT"},{"text":"                    st.error(f\"Operation failed: {e}\")","action":"LINE_ACTION_INSERT"},{"text":"                    if hasattr(e, 'response') and e.response is not None:","action":"LINE_ACTION_INSERT"},{"text":"                        try:","action":"LINE_ACTION_INSERT"},{"text":"                            st.json(e.response.json())","action":"LINE_ACTION_INSERT"},{"text":"                        except Exception:","action":"LINE_ACTION_INSERT"},{"text":"                            st.write(e.response.text)","action":"LINE_ACTION_INSERT"},{"text":"        else:","action":"LINE_ACTION_INSERT"},{"text":"            st.warning(\"Please upload a CSV file first.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"with tab2:","action":"LINE_ACTION_INSERT"},{"text":"    st.header(\"Upload & Find Anomalies\")","action":"LINE_ACTION_INSERT"},{"text":"    st.write(\"Instantly evaluate a dataset for anomalies without persisting it to the training database.\")","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    col3, col4 = st.columns(2)","action":"LINE_ACTION_INSERT"},{"text":"    with col3:","action":"LINE_ACTION_INSERT"},{"text":"        tenant_id_inf = st.text_input(\"Tenant ID\", \"tenant_1\", key=\"tenant_inf\")","action":"LINE_ACTION_INSERT"},{"text":"        greenhouse_id_inf = st.text_input(\"Greenhouse ID\", \"default\", key=\"greenhouse_inf\")","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"    uploaded_file_inf = st.file_uploader(\"Choose a CSV file for anomaly detection\", type=\"csv\", key=\"file_inf\")","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    if st.button(\"Find Anomalies\", type=\"primary\"):","action":"LINE_ACTION_INSERT"},{"text":"        if not tenant_id_inf or not greenhouse_id_inf:","action":"LINE_ACTION_INSERT"},{"text":"            st.warning(\"Tenant ID and Greenhouse ID cannot be empty.\")","action":"LINE_ACTION_INSERT"},{"text":"        elif uploaded_file_inf is not None:","action":"LINE_ACTION_INSERT"},{"text":"            with st.spinner(\"Running inference pipeline...\"):","action":"LINE_ACTION_INSERT"},{"text":"                files = {\"file\": (uploaded_file_inf.name, uploaded_file_inf.getvalue(), \"text/csv\")}","action":"LINE_ACTION_INSERT"},{"text":"                data = {\"tenant_id\": tenant_id_inf, \"greenhouse_id\": greenhouse_id_inf}","action":"LINE_ACTION_INSERT"},{"text":"                ","action":"LINE_ACTION_INSERT"},{"text":"                try:","action":"LINE_ACTION_INSERT"},{"text":"                    res_inf = requests.post(f\"{API_URL}/api/inference/upload\", files=files, data=data)","action":"LINE_ACTION_INSERT"},{"text":"                    res_inf.raise_for_status()","action":"LINE_ACTION_INSERT"},{"text":"                    results = res_inf.json()","action":"LINE_ACTION_INSERT"},{"text":"                    ","action":"LINE_ACTION_INSERT"},{"text":"                    st.success(f\"Processed {results.get('sequences_processed', 0)} sequences. Detected {results.get('anomalies_detected', 0)} anomalies.\")","action":"LINE_ACTION_INSERT"},{"text":"                    ","action":"LINE_ACTION_INSERT"},{"text":"                    # Visualization","action":"LINE_ACTION_INSERT"},{"text":"                    scores = results.get(\"anomaly_scores\", [])","action":"LINE_ACTION_INSERT"},{"text":"                    if scores:","action":"LINE_ACTION_INSERT"},{"text":"                        df_scores = pd.DataFrame({","action":"LINE_ACTION_INSERT"},{"text":"                            \"Sequence Index\": range(len(scores)),","action":"LINE_ACTION_INSERT"},{"text":"                            \"Anomaly Score\": scores","action":"LINE_ACTION_INSERT"},{"text":"                        })","action":"LINE_ACTION_INSERT"},{"text":"                        ","action":"LINE_ACTION_INSERT"},{"text":"                        fig = px.line(df_scores, x=\"Sequence Index\", y=\"Anomaly Score\", title=\"Anomaly Scores over Time\")","action":"LINE_ACTION_INSERT"},{"text":"                        fig.add_hline(y=ANOMALY_THRESHOLD, line_dash=\"dash\", line_color=\"red\", annotation_text=\"Anomaly Threshold\")","action":"LINE_ACTION_INSERT"},{"text":"                        ","action":"LINE_ACTION_INSERT"},{"text":"                        st.plotly_chart(fig, use_container_width=True)","action":"LINE_ACTION_INSERT"},{"text":"                    ","action":"LINE_ACTION_INSERT"},{"text":"                    high_anomalies = results.get(\"high_anomalies\", [])","action":"LINE_ACTION_INSERT"},{"text":"                    if high_anomalies:","action":"LINE_ACTION_INSERT"},{"text":"                        st.subheader(\"High Anomalies Detected\")","action":"LINE_ACTION_INSERT"},{"text":"                        df_high = pd.DataFrame(high_anomalies)","action":"LINE_ACTION_INSERT"},{"text":"                        st.dataframe(df_high)","action":"LINE_ACTION_INSERT"},{"text":"                    else:","action":"LINE_ACTION_INSERT"},{"text":"                        st.info(\"No high anomalies detected in this dataset.\")","action":"LINE_ACTION_INSERT"},{"text":"                        ","action":"LINE_ACTION_INSERT"},{"text":"                except requests.exceptions.RequestException as e:","action":"LINE_ACTION_INSERT"},{"text":"                    st.error(f\"Inference failed: {e}\")","action":"LINE_ACTION_INSERT"},{"text":"                    if hasattr(e, 'response') and e.response is not None:","action":"LINE_ACTION_INSERT"},{"text":"                        try:","action":"LINE_ACTION_INSERT"},{"text":"                            st.json(e.response.json())","action":"LINE_ACTION_INSERT"},{"text":"                        except Exception:","action":"LINE_ACTION_INSERT"},{"text":"                            st.write(e.response.text)","action":"LINE_ACTION_INSERT"},{"text":"        else:","action":"LINE_ACTION_INSERT"},{"text":"            st.warning(\"Please upload a CSV file first.\")","action":"LINE_ACTION_INSERT"},{"text":"```","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"}]}]}}}
