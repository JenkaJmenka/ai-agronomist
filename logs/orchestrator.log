   Session = sessionmaker(bind=engine)","action":"LINE_ACTION_INSERT"},{"text":"    session = Session()","action":"LINE_ACTION_INSERT"},{"text":"    try:","action":"LINE_ACTION_INSERT"},{"text":"        yield session","action":"LINE_ACTION_INSERT"},{"text":"    finally:","action":"LINE_ACTION_INSERT"},{"text":"        session.close()","action":"LINE_ACTION_INSERT"},{"text":"        Base.metadata.drop_all(engine)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_base_class_setup():","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Verify that Base is the declarative base class for all models.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    assert issubclass(SensorReading, Base)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_sensor_reading_table_structure():","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Verify table name and required columns/indexes on the sensor_readings table.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    engine = create_engine(\"sqlite:///:memory:\")","action":"LINE_ACTION_INSERT"},{"text":"    inspector = inspect(engine)","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    # Assert table exists after creation","action":"LINE_ACTION_INSERT"},{"text":"    Base.metadata.create_all(engine)","action":"LINE_ACTION_INSERT"},{"text":"    tables = inspector.get_table_names()","action":"LINE_ACTION_INSERT"},{"text":"    assert \"sensor_readings\" in tables","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Verify column structures","action":"LINE_ACTION_INSERT"},{"text":"    columns = {col[\"name\"]: col for col in inspector.get_columns(\"sensor_readings\")}","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    required_fields = [","action":"LINE_ACTION_INSERT"},{"text":"        \"id\", \"tenant_id\", \"greenhouse_id\", \"timestamp\", \"temperature\",","action":"LINE_ACTION_INSERT"},{"text":"        \"humidity\", \"co2\", \"light\", \"anomaly_score\", \"created_at\"","action":"LINE_ACTION_INSERT"},{"text":"    ]","action":"LINE_ACTION_INSERT"},{"text":"    for field in required_fields:","action":"LINE_ACTION_INSERT"},{"text":"        assert field in columns, f\"Column '{field}' is missing from sensor_readings table.\"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Verify column nullability and types (where SQLite reports standard mappings)","action":"LINE_ACTION_INSERT"},{"text":"    assert columns[\"id\"][\"primary_key\"] == 1","action":"LINE_ACTION_INSERT"},{"text":"    assert not columns[\"tenant_id\"][\"nullable\"]","action":"LINE_ACTION_INSERT"},{"text":"    assert not columns[\"greenhouse_id\"][\"nullable\"]","action":"LINE_ACTION_INSERT"},{"text":"    assert not columns[\"timestamp\"][\"nullable\"]","action":"LINE_ACTION_INSERT"},{"text":"    assert not columns[\"temperature\"][\"nullable\"]","action":"LINE_ACTION_INSERT"},{"text":"    assert not columns[\"humidity\"][\"nullable\"]","action":"LINE_ACTION_INSERT"},{"text":"    assert not columns[\"co2\"][\"nullable\"]","action":"LINE_ACTION_INSERT"},{"text":"    assert not columns[\"light\"][\"nullable\"]","action":"LINE_ACTION_INSERT"},{"text":"    assert columns[\"anomaly_score\"][\"nullable\"]","action":"LINE_ACTION_INSERT"},{"text":"    assert not columns[\"created_at\"][\"nullable\"]","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Verify indexes exist for tenant_id and timestamp","action":"LINE_ACTION_INSERT"},{"text":"    indexes = {idx[\"name\"]: idx for idx in inspector.get_indexes(\"sensor_readings\")}","action":"LINE_ACTION_INSERT"},{"text":"    # SQLite indexes usually auto-named or user-named","action":"LINE_ACTION_INSERT"},{"text":"    index_cols = [col for idx in indexes.values() for col in idx[\"column_names\"]]","action":"LINE_ACTION_INSERT"},{"text":"    assert \"tenant_id\" in index_cols, \"Index missing on tenant_id column.\"","action":"LINE_ACTION_INSERT"},{"text":"    assert \"timestamp\" in index_cols, \"Index missing on timestamp column.\"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_sensor_reading_create_and_query(db_session):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Test standard instantiation, persistence, and querying of a SensorReading.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    now = datetime.now(timezone.utc)","action":"LINE_ACTION_INSERT"},{"text":"    reading = SensorReading(","action":"LINE_ACTION_INSERT"},{"text":"        tenant_id=\"tenant-123\",","action":"LINE_ACTION_INSERT"},{"text":"        greenhouse_id=\"greenhouse-abc\",","action":"LINE_ACTION_INSERT"},{"text":"        timestamp=now,","action":"LINE_ACTION_INSERT"},{"text":"        temperature=24.5,","action":"LINE_ACTION_INSERT"},{"text":"        humidity=62.3,","action":"LINE_ACTION_INSERT"},{"text":"        co2=450.0,","action":"LINE_ACTION_INSERT"},{"text":"        light=800.0,","action":"LINE_ACTION_INSERT"},{"text":"        anomaly_score=0.12","action":"LINE_ACTION_INSERT"},{"text":"    )","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    db_session.add(reading)","action":"LINE_ACTION_INSERT"},{"text":"    db_session.commit()","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    # Query back","action":"LINE_ACTION_INSERT"},{"text":"    retrieved = db_session.query(SensorReading).filter_by(tenant_id=\"tenant-123\").first()","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved is not None","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved.id == 1","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved.tenant_id == \"tenant-123\"","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved.greenhouse_id == \"greenhouse-abc\"","action":"LINE_ACTION_INSERT"},{"text":"    # Note: SQLite date roundtrip may lose tz offset representation depending on config, but the time matches.","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved.temperature == 24.5","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved.humidity == 62.3","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved.co2 == 450.0","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved.light == 800.0","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved.anomaly_score == 0.12","action":"LINE_ACTION_INSERT"},{"text":"    ","action":"LINE_ACTION_INSERT"},{"text":"    # Assert created_at auto-populated","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved.created_at is not None","action":"LINE_ACTION_INSERT"},{"text":"    assert isinstance(retrieved.created_at, datetime)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_sensor_reading_optional_anomaly_score(db_session):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Verify that is acceptable to have an empty/None anomaly_score.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    now = datetime.now(timezone.utc)","action":"LINE_ACTION_INSERT"},{"text":"    reading = SensorReading(","action":"LINE_ACTION_INSERT"},{"text":"        tenant_id=\"tenant-123\",","action":"LINE_ACTION_INSERT"},{"text":"        greenhouse_id=\"greenhouse-abc\",","action":"LINE_ACTION_INSERT"},{"text":"        timestamp=now,","action":"LINE_ACTION_INSERT"},{"text":"        temperature=22.0,","action":"LINE_ACTION_INSERT"},{"text":"        humidity=55.0,","action":"LINE_ACTION_INSERT"},{"text":"        co2=400.0,","action":"LINE_ACTION_INSERT"},{"text":"        light=600.0,","action":"LINE_ACTION_INSERT"},{"text":"        anomaly_score=None  # Explicitly None","action":"LINE_ACTION_INSERT"},{"text":"    )","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    db_session.add(reading)","action":"LINE_ACTION_INSERT"},{"text":"    db_session.commit()","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    retrieved = db_session.query(SensorReading).filter_by(tenant_id=\"tenant-123\").first()","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved is not None","action":"LINE_ACTION_INSERT"},{"text":"    assert retrieved.anomaly_score is None","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"def test_sensor_reading_repr():","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"Verify the developer-friendly string representation of SensorReading.\"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    reading = SensorReading(","action":"LINE_ACTION_INSERT"},{"text":"        id=42,","action":"LINE_ACTION_INSERT"},{"text":"        tenant_id=\"test_tenant\",","action":"LINE_ACTION_INSERT"},{"text":"        greenhouse_id=\"greenhouse_1\",","action":"LINE_ACTION_INSERT"},{"text":"        timestamp=datetime(2026, 6, 8, 12, 0, 0, tzinfo=timezone.utc),","action":"LINE_ACTION_INSERT"},{"text":"        temperature=23.5,","action":"LINE_ACTION_INSERT"},{"text":"        humidity=60.0,","action":"LINE_ACTION_INSERT"},{"text":"        co2=420.0,","action":"LINE_ACTION_INSERT"},{"text":"        light=500.0,","action":"LINE_ACTION_INSERT"},{"text":"        anomaly_score=0.01","action":"LINE_ACTION_INSERT"},{"text":"    )","action":"LINE_ACTION_INSERT"},{"text":"    r_str = repr(reading)","action":"LINE_ACTION_INSERT"},{"text":"    assert \"id=42\" in r_str","action":"LINE_ACTION_INSERT"},{"text":"    assert \"tenant_id='test_tenant'\" in r_str","action":"LINE_ACTION_INSERT"},{"text":"    assert \"greenhouse_id='greenhouse_1'\" in r_str","action":"LINE_ACTION_INSERT"},{"text":"    assert \"temperature=23.5\" in r_str","action":"LINE_ACTION_INSERT"},{"text":"    assert \"