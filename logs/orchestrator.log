2026-06-08 18:32:42,033 - root - INFO - RAW WS MSG: {"seqNum":"41","timestampMicros":"1780939962033081","stepUpdate":{"cascadeId":"e859cd0bbf4f8529033971397b5ecc93","trajectoryId":"e859cd0bbf4f8529033971397b5ecc93","stepIndex":14,"state":"STATE_DONE","source":"SOURCE_MODEL","target":"TARGET_ENVIRONMENT","thinking":"","textDelta":"","thinkingDelta":"","text":"File write","editFile":{"filePath":"file:///Users/eugenesidorov/Projects/ai-agronomist/src/models/csv_adapter.py","diffBlock":[{"startLine":0,"endLine":0,"lines":[{"text":"import pandas as pd","action":"LINE_ACTION_INSERT"},{"text":"from typing import Dict","action":"LINE_ACTION_INSERT"},{"text":"from src.models.data_source import DataSourceAdapter","action":"LINE_ACTION_INSERT"},{"text":"import logging","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"logging.basicConfig(level=logging.INFO)","action":"LINE_ACTION_INSERT"},{"text":"logger = logging.getLogger(__name__)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"class CSVAdapter(DataSourceAdapter):","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"    Data source adapter for reading and processing data from CSV files.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    This adapter handles CSV file reading, data validation against a predefined","action":"LINE_ACTION_INSERT"},{"text":"    schema, and normalization of sensor readings to a [0, 1] range based on","action":"LINE_ACTION_INSERT"},{"text":"    configured min/max values.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    Attributes:","action":"LINE_ACTION_INSERT"},{"text":"        required_columns (Dict[str, type]): A dictionary defining the expected","action":"LINE_ACTION_INSERT"},{"text":"            column names and their corresponding data types.","action":"LINE_ACTION_INSERT"},{"text":"        sensor_ranges (Dict[str, tuple]): A dictionary specifying the min and","action":"LINE_ACTION_INSERT"},{"text":"            max values for each sensor column, used for normalization.","action":"LINE_ACTION_INSERT"},{"text":"    \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def __init__(self, required_columns: Dict[str, type], sensor_ranges: Dict[str, tuple]):","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Initializes the CSVAdapter with schema and normalization configurations.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            required_columns (Dict[str, type]): Dictionary defining the required","action":"LINE_ACTION_INSERT"},{"text":"                column names and their expected Python data types.","action":"LINE_ACTION_INSERT"},{"text":"                Example: {'timestamp': str, 'temperature': float}","action":"LINE_ACTION_INSERT"},{"text":"            sensor_ranges (Dict[str, tuple]): Dictionary defining the min and max","action":"LINE_ACTION_INSERT"},{"text":"                values for sensor columns to be normalized.","action":"LINE_ACTION_INSERT"},{"text":"                Example: {'temperature': (0, 100)}","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        self.required_columns = required_columns","action":"LINE_ACTION_INSERT"},{"text":"        self.sensor_ranges = sensor_ranges","action":"LINE_ACTION_INSERT"},{"text":"        logger.info(\"CSVAdapter initialized with required columns and sensor ranges.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def read_data(self, file_path: str) -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Reads data from a CSV file into a pandas DataFrame.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            file_path (str): The path to the CSV file.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            pd.DataFrame: A DataFrame containing the data from the CSV file.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        logger.info(f\"Reading data from {file_path}\")","action":"LINE_ACTION_INSERT"},{"text":"        try:","action":"LINE_ACTION_INSERT"},{"text":"            df = pd.read_csv(file_path)","action":"LINE_ACTION_INSERT"},{"text":"            logger.info(f\"Successfully loaded {len(df)} rows from {file_path}\")","action":"LINE_ACTION_INSERT"},{"text":"            return df","action":"LINE_ACTION_INSERT"},{"text":"        except FileNotFoundError:","action":"LINE_ACTION_INSERT"},{"text":"            logger.error(f\"File not found at {file_path}\")","action":"LINE_ACTION_INSERT"},{"text":"            raise","action":"LINE_ACTION_INSERT"},{"text":"        except Exception as e:","action":"LINE_ACTION_INSERT"},{"text":"            logger.error(f\"An error occurred while reading the CSV file: {e}\")","action":"LINE_ACTION_INSERT"},{"text":"            raise","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def validate_data(self, df: pd.DataFrame) -> None:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Validates the DataFrame against the required columns and data types.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        This method checks for the presence of all required columns and verifies","action":"LINE_ACTION_INSERT"},{"text":"        that each column's data type matches the specified type.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            df (pd.DataFrame): The DataFrame to be validated.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Raises:","action":"LINE_ACTION_INSERT"},{"text":"            ValueError: If a required column is missing, if an extra column is found,","action":"LINE_ACTION_INSERT"},{"text":"                        or if a column's data type is incorrect.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        logger.info(\"Starting data validation.\")","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        # Check for missing columns","action":"LINE_ACTION_INSERT"},{"text":"        for col_name in self.required_columns:","action":"LINE_ACTION_INSERT"},{"text":"            if col_name not in df.columns:","action":"LINE_ACTION_INSERT"},{"text":"                msg = f\"Missing required column: '{col_name}'\"","action":"LINE_ACTION_INSERT"},{"text":"                logger.error(msg)","action":"LINE_ACTION_INSERT"},{"text":"                raise ValueError(msg)","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        # Check for extra columns","action":"LINE_ACTION_INSERT"},{"text":"        for col_name in df.columns:","action":"LINE_ACTION_INSERT"},{"text":"            if col_name not in self.required_columns:","action":"LINE_ACTION_INSERT"},{"text":"                msg = f\"Unexpected column found: '{col_name}'\"","action":"LINE_ACTION_INSERT"},{"text":"                logger.error(msg)","action":"LINE_ACTION_INSERT"},{"text":"                raise ValueError(msg)","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        # Check column data types","action":"LINE_ACTION_INSERT"},{"text":"        for col_name, expected_type in self.required_columns.items():","action":"LINE_ACTION_INSERT"},{"text":"            if not pd.api.types.is_dtype_equal(df[col_name].dtype, expected_type):","action":"LINE_ACTION_INSERT"},{"text":"                try:","action":"LINE_ACTION_INSERT"},{"text":"                    # Attempt to cast the column to the expected type","action":"LINE_ACTION_INSERT"},{"text":"                    df[col_name] = df[col_name].astype(expected_type)","action":"LINE_ACTION_INSERT"},{"text":"                    logger.warning(f\"Casted column '{col_name}' to {expected_type}.\")","action":"LINE_ACTION_INSERT"},{"text":"                except (TypeError, ValueError) as e:","action":"LINE_ACTION_INSERT"},{"text":"                    msg = f\"Column '{col_name}' has incorrect type {df[col_name].dtype}, expected {expected_type}. Casting failed: {e}\"","action":"LINE_ACTION_INSERT"},{"text":"                    logger.error(msg)","action":"LINE_ACTION_INSERT"},{"text":"                    raise ValueError(msg)","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        logger.info(\"Data validation successful.\")","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"    def normalize_data(self, df: pd.DataFrame) -> pd.DataFrame:","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        Normalizes sensor data to a [0, 1] range.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        The normalization is performed based on the min/max values specified in","action":"LINE_ACTION_INSERT"},{"text":"        the `sensor_ranges` configuration. Only columns present in `sensor_ranges`","action":"LINE_ACTION_INSERT"},{"text":"        are normalized.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Args:","action":"LINE_ACTION_INSERT"},{"text":"            df (pd.DataFrame): The DataFrame with sensor data to be normalized.","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"},{"text":"        Returns:","action":"LINE_ACTION_INSERT"},{"text":"            pd.DataFrame: A new DataFrame with normalized values. The original","action":"LINE_ACTION_INSERT"},{"text":"                          DataFrame is not modified.","action":"LINE_ACTION_INSERT"},{"text":"        \"\"\"","action":"LINE_ACTION_INSERT"},{"text":"        logger.info(\"Starting data normalization.\")","action":"LINE_ACTION_INSERT"},{"text":"        df_normalized = df.copy()","action":"LINE_ACTION_INSERT"},{"text":"        for col_name, (min_val, max_val) in self.sensor_ranges.items():","action":"LINE_ACTION_INSERT"},{"text":"            if col_name in df_normalized.columns:","action":"LINE_ACTION_INSERT"},{"text":"                if min_val == max_val:","action":"LINE_ACTION_INSERT"},{"text":"                    # Avoid division by zero if min and max are the same","action":"LINE_ACTION_INSERT"},{"text":"                    df_normalized[col_name] = 0.5","action":"LINE_ACTION_INSERT"},{"text":"                else:","action":"LINE_ACTION_INSERT"},{"text":"                    df_normalized[col_name] = (df_normalized[col_name] - min_val) / (max_val - min_val)","action":"LINE_ACTION_INSERT"},{"text":"                logger.info(f\"Normalized column '{col_name}'.\")","action":"LINE_ACTION_INSERT"},{"text":"        ","action":"LINE_ACTION_INSERT"},{"text":"        logger.info(\"Data normalization complete.\")","action":"LINE_ACTION_INSERT"},{"text":"        return df_normalized","action":"LINE_ACTION_INSERT"},{"text":"","action":"LINE_ACTION_INSERT"}]}]}}}
